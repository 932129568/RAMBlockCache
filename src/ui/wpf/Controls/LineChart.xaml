<UserControl x:Class="RamBoostFS.Wpf.Controls.LineChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="160" d:DesignWidth="400">
    <Grid ClipToBounds="True">
        <!-- 水平网格线 -->
        <Grid x:Name="gridLines">
            <Line Stroke="#22FFFFFF" StrokeThickness="0.5" VerticalAlignment="Top"/>
            <Line Stroke="#18FFFFFF" StrokeThickness="0.5" VerticalAlignment="Center"/>
            <Line Stroke="#22FFFFFF" StrokeThickness="0.5" VerticalAlignment="Bottom"/>
        </Grid>
        <Canvas x:Name="chartCanvas" ClipToBounds="True"/>
    </Grid>
</UserControl>
