<Window x:Class="RAMBlockCache.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RAMBlockCache 安装" Height="520" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource RbcBgApp}" Foreground="{StaticResource RbcTextPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 页眉 ===== -->
        <StackPanel Grid.Row="0" Margin="28,22,28,0">
            <TextBlock Text="RAMBlockCache" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource RbcTextPrimary}"/>
            <TextBlock Text="用内存给你的数据盘加速 · 系统盘默认不加速"
                       FontSize="12" Margin="0,4,0,0"
                       Foreground="{StaticResource RbcTextSecondary}"/>
        </StackPanel>

        <!-- ===== 内容区（安装四页 / 卸载一页） ===== -->
        <Grid Grid.Row="1" Margin="28,18,28,0">

            <!-- 欢迎页 -->
            <StackPanel Orientation="Vertical" Visibility="{Binding ShowWelcome, Converter={StaticResource B2V}}">
                <TextBlock Text="欢迎" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource RbcTextSecondary}"
                           Text="本向导将完成 RAMBlockCache 驱动安装（共四步，约 1 分钟）。&#x0a;&#x0a;· 生产模式：安装后需要重启一次，之后缓存自动生效（与同类产品一致）；&#x0a;· 安装过程先做驱动签名校验，未通过时不会改动系统任何设置。"/>
                <Border Margin="0,18,0,0" Padding="14" CornerRadius="6" Background="{StaticResource RbcBgSurface}">
                    <StackPanel>
                        <TextBlock Text="适用 / 不适用（预期管理）" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RbcWarningFg}" Margin="0,0,0,6"/>
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource RbcTextSecondary}"
                                   Text="适用：机械硬盘 / SATA SSD 上的数据卷随机读写、二次加载、顺序读场景，收益通常明显。&#x0a;不适用：NVMe 系统盘收益有限（盘本身已快）；数据库/编译等持续大写场景请保持直写默认，按需再开回写。"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 许可协议页 -->
            <StackPanel Orientation="Vertical" Visibility="{Binding ShowLicense, Converter={StaticResource B2V}}">
                <TextBlock Text="许可协议" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border Height="210" CornerRadius="6" Background="{StaticResource RbcBgSurface}" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource RbcTextSecondary}"
                                   Text="RAMBlockCache 按“现状”提供，不含任何明示或默示担保。&#x0a;&#x0a;1. 本软件为卷级块缓存过滤驱动：错误配置或硬件异常场景下存在数据丢失的理论风险，重要数据请另行备份。&#x0a;2. 默认安全姿态：系统盘默认不加速；写模式默认直写（写同时落盘）；回写由你对数据卷显式开启。&#x0a;3. 测试签名版本仅在开启 testsigning 的开发/测试环境可用，不得用于生产。&#x0a;4. 你不得对本软件进行反向工程、再分发或用于非法用途。"/>
                    </ScrollViewer>
                </Border>
                <CheckBox Margin="0,12,0,0" Foreground="{StaticResource RbcTextPrimary}" FontSize="13"
                          Content="我已阅读并接受上述条款"
                          IsChecked="{Binding LicenseAccepted, Mode=TwoWay}"/>
                <!-- [FIX 高-2] TestMode 选项原先在安装页，进入瞬间引擎即启动，用户根本没
                     机会勾选。v2 起安装前多了一个目录页，TestMode 移到目录页——仍是
                     安装启动（引擎启动）前的最后选择点。 -->
            </StackPanel>

            <!-- 目录页（U0-2 v2：自定义安装目录 + 选项） -->
            <StackPanel Orientation="Vertical" Visibility="{Binding ShowDirectory, Converter={StaticResource B2V}}">
                <TextBlock Text="安装位置与选项" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,0,0,4"
                           Text="安装目录（控制台 / CLI / 文档）"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Height="30" Padding="8,4"
                             Background="{StaticResource RbcBgSurface}" Foreground="{StaticResource RbcTextPrimary}"
                             BorderBrush="{StaticResource RbcBorder}" FontSize="13"
                             Text="{Binding InstallDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Width="76" Height="30"
                            Style="{StaticResource BtnSecondary}" Command="{Binding BrowseCommand}"/>
                </Grid>
                <TextBlock Text="{Binding DirError}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource RbcWarningFg}"/>
                <TextBlock Text="{Binding DirNote}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource RbcTextTertiary}"/>
                <Separator Margin="0,14,0,12" Background="{StaticResource RbcBorder}"/>
                <CheckBox FontSize="13" Foreground="{StaticResource RbcTextPrimary}"
                          Content="创建桌面快捷方式" IsChecked="{Binding DesktopShortcut, Mode=TwoWay}"/>
                <CheckBox Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource RbcTextPrimary}"
                          Content="创建开始菜单快捷方式" IsChecked="{Binding StartMenuShortcut, Mode=TwoWay}"/>
                <CheckBox Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource RbcTextPrimary}"
                          Content="安装完成后启动控制台" IsChecked="{Binding LaunchController, Mode=TwoWay}"/>
                <!-- [102] 测试模式（DEMAND_START + 运行时挂栈）是开发者调试路径，对用户
                     只会扩大风险面（运行期挂栈卷走完整拆除路径）且与生产 BOOT_START 冲突。
                     已从安装界面移除：安装一律走生产模式（BOOT_START，装后重启一次生效）。
                     引擎能力保留（/TestMode 参数仍在），仅供开发/QA 手工调用。 -->
                <TextBlock Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource RbcTextSecondary}"
                           Text="安装方式：生产模式（驱动随系统引导加载，装完重启一次即生效）。"/>

                <!-- [COVERAGE 2026-11-05] 已安装检测与清洁安装选项 -->
                <Border Margin="0,16,0,0" Padding="10" CornerRadius="6"
                        Background="#F6F8FB" BorderBrush="#E1E7EF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RbcTextPrimary}"
                                   Text="{Binding ExistingDetail}" TextWrapping="Wrap"/>
                        <CheckBox Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource RbcTextSecondary}"
                                  Visibility="{Binding HasExisting, Converter={StaticResource B2V}}"
                                  Content="清洁安装（清除旧配置与日志；不勾选则覆盖安装并保留配置）"
                                  IsChecked="{Binding CleanInstall, Mode=TwoWay}"
                                  IsEnabled="{Binding Busy, Converter={StaticResource NotB}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 安装页（进度） -->
            <Grid Visibility="{Binding ShowInstall, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="正在安装" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                </StackPanel>
                <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="6" Background="{StaticResource RbcBgSurface}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Log}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{StaticResource RbcTextSecondary}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 完成页 -->
            <StackPanel Orientation="Vertical" Visibility="{Binding ShowComplete, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                           Foreground="{Binding Succeeded, Converter={StaticResource B2VSuccess}}"/>
                <TextBlock Text="{Binding ErrorDetail}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource RbcTextSecondary}"/>
                <Border Margin="0,14,0,0" Padding="14" CornerRadius="6" Background="{StaticResource RbcBgSurface}">
                    <TextBlock Text="{Binding FixSteps}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource RbcTextSecondary}"/>
                </Border>
                <Border Margin="0,14,0,0" MaxHeight="120" CornerRadius="6" Background="{StaticResource RbcBgSurface}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Log}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas"
                                               Foreground="{StaticResource RbcTextTertiary}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- 卸载页 -->
            <StackPanel Orientation="Vertical" Visibility="{Binding ShowUninstall, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                           Foreground="{Binding Succeeded, Converter={StaticResource B2VSuccess}}"/>
                <Border Height="240" CornerRadius="6" Background="{StaticResource RbcBgSurface}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Log}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{StaticResource RbcTextSecondary}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock Text="{Binding FixSteps}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{StaticResource RbcTextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- ===== 底部按钮条 ===== -->
        <Grid Grid.Row="2" Margin="28,16,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource RbcTextTertiary}"
                       Text="安装即表示接受：装后重启一次生效 · 日志 %ProgramData%\RAMBlockCache\logs"/>
            <!-- [FIX QA5-UI6] 取消通道可见化：原 CancelCommand 从未绑定（死代码），
                 安装/卸载中用户无任何中止入口。Busy 时显示；点击停止 GUI 等待
                 （引擎进程会自行完成——fail-closed 保证未做不可逆变更）。 -->
            <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="取消" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding Busy, Converter={StaticResource B2V}}"/>
            <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="上一步" Margin="0,0,8,0"
                    Command="{Binding BackCommand}"
                    Visibility="{Binding Busy, Converter={StaticResource NotB2V}}"/>
            <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="下一步"
                    Command="{Binding NextCommand}"
                    Visibility="{Binding ShowComplete, Converter={StaticResource NotB2V}}"/>
            <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="完成"
                    Command="{Binding FinishCommand}"
                    Visibility="{Binding ShowComplete, Converter={StaticResource B2V}}"/>
            <Button Grid.Column="3" Style="{StaticResource BtnDanger}" Content="立即重启" Margin="8,0,0,0"
                    Command="{Binding RebootCommand}"
                    Visibility="{Binding Succeeded, Converter={StaticResource B2V}}"/>
        </Grid>
    </Grid>
</Window>
