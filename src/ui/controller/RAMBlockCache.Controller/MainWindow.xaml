<Window x:Class="RAMBlockCache.Controller.MainWindow" x:Name="Win"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:RAMBlockCache.Controller.Controls"
        xmlns:services="clr-namespace:RAMBlockCache.Controller.Services"
        Title="RAMBlockCache 控制器" Height="780" Width="1180" MinHeight="600" MinWidth="900"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="{StaticResource RbcFontUi}" FontSize="13">
    <Window.Resources>
        <!-- 导航项样式（04b §8.3：Padding 12,8 / 间距 4 / H2 14 / 600 选中态） -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource RbcTextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource RbcRadiusSm}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource RbcBgSurface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource RbcBgSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource RbcTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 页面切换 DataTrigger 模板（Visibility 结构不动；入场动画见 MainWindow.xaml.cs） -->
        <Style x:Key="PageVisible" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- [W1.5 截图比对] 列表卡铺满行宽容器（原型 volrow/卷卡=块级铺满）：默认 ListBoxItem
             HorizontalContentAlignment=Left 且模板带内衬 → 行卡只随内容收缩不铺满（截图圈出）。
             裸 ContentPresenter 模板=零内衬零选中铬（行是信息卡非选项），Stretch 撑满列表宽。
             [设计 v2 2026-10-24] 显式 Foreground：裸模板让徽标/行文字继承 ListBox 的
             SystemColors.ControlText（系统黑）→ 暗底黑字不可读（加速页截图实锤）。 -->
        <Style x:Key="StretchItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource RbcTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- [契约 V9] 常驻四段状态条：驱动 / 挂栈 / 加速 / 风险（异常段变色可点击） -->
            <ctl:StateBar DockPanel.Dock="Top" x:Name="StateBarCtl"/>

            <!-- Banner 语义双形态（转译映射 §2.3：统计降级=警告底，握手失败/未提权=危险底） -->
            <Border DockPanel.Dock="Top" Background="{StaticResource RbcWarningBg}" Padding="16,8"
                    Visibility="{Binding BannerIsWarning, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Banner, Mode=OneWay}" Foreground="{StaticResource RbcWarningFg}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="前往处置" Command="{Binding GoPageCommand}" CommandParameter="诊断"
                            Style="{StaticResource BtnGhost}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
            <Border DockPanel.Dock="Top" Background="{StaticResource RbcDangerBg}" Padding="16,8"
                    Visibility="{Binding BannerDangerVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Banner, Mode=OneWay}" Foreground="{StaticResource RbcDangerFg}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="前往处置" Command="{Binding GoPageCommand}" CommandParameter="诊断"
                            Style="{StaticResource BtnGhost}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- 左侧导航（六页任务导向 IA：状态/加速/收益/诊断/应急/设置；应急项带异常徽标） -->
            <Border DockPanel.Dock="Left" Width="{StaticResource RbcSidebarWidth}" Background="{StaticResource RbcBgSidebar}" Margin="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,20,16,8">
                        <TextBlock Text="RAMBlockCache" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RbcTextPrimary}"/>
                        <TextBlock Text="{Binding TitleExtra, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="12,8,12,0"
                             ItemContainerStyle="{StaticResource NavItemStyle}">                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 导航图标（选中态随容器 Foreground 继承变色； glyph 走 DataTrigger 逐项映射） -->
                                    <TextBlock x:Name="icon" Grid.Column="0" Width="24" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center"/>
                                    <!-- 应急项异常徽标（§2.1：pill 16px 高 · 白字 10px/600 · bg RbcDangerSolid；无异常时 Opacity 0） -->
                                    <Border x:Name="badge" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MinWidth="16" Height="16" CornerRadius="8" Margin="0,0,8,0"
                                            Background="{StaticResource RbcDangerSolid}" Visibility="Collapsed"
                                            Opacity="{Binding DataContext.EmergencyBadgeOpacity, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <TextBlock Text="{Binding DataContext.EmergencyBadgeText, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   Foreground="White" FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="状态">
                                        <Setter TargetName="icon" Property="Text" Value="◉"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="加速">
                                        <Setter TargetName="icon" Property="Text" Value="⚡"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="收益">
                                        <Setter TargetName="icon" Property="Text" Value="▤"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="诊断">
                                        <Setter TargetName="icon" Property="Text" Value="◐"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="应急">
                                        <Setter TargetName="icon" Property="Text" Value="⚠"/>
                                        <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="设置">
                                        <Setter TargetName="icon" Property="Text" Value="⚙"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 侧栏底状态（原型 sidebar-foot：动效态 + 采样频率） -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                        <TextBlock Text="{Binding MotionStateText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RbcTextTertiary}"/>
                        <TextBlock Text="统计采样：每秒" FontSize="11" Foreground="{StaticResource RbcTextTertiary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 内容区 -->
            <Grid Margin="20">

                <!-- ============ 状态（首页：只回答"现在怎样"；全局操作迁加速/应急页） ============ -->
                <Border x:Name="PageStatus">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PageVisible}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="状态">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="状态" FontSize="20" FontWeight="SemiBold"/>
                                    <!-- [T4] 副标题绑 VM 只读属性 StatusSubtitle（Mode=OneWay）：
                                         挂载 >0「缓存正在保护 N 个卷」/ =0 空态指引；不再硬编码 -->
                                    <TextBlock Text="{Binding StatusSubtitle, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- [A-12] 电源 chip（KPI 区位；有回写卷时常驻，与应急页/F3 对话框同 Key 同口径） -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TitleExtra, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource RbcPowerStateChip}" DataContext="{Binding Features}" Margin="12,0,0,0"
                                            Visibility="{Binding DataContext.HasWritebackVolume, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource RbcPowerStateDot}"/>
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12">
                                                <Run Text="{Binding PowerStateLabel, Mode=OneWay}"/><Run Text="{Binding PowerStatePct, Mode=OneWay}" FontFamily="{StaticResource RbcFontMono}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- KPI 三卡（bento，对齐原型：命中率 / 省下磁盘读 GB / 占用环+上限+已用%）
                                 [W1.5 S13 用户 17:47] 卡内容整体居中（原左上堆叠+底部大片空白）；占用环去环心数字 -->
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,0,8,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="平均缓存命中率" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" HorizontalAlignment="Center"/>
                                        <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding KpiHasData, Converter={StaticResource BoolToVis}}">
                                                <TextBlock ctl:NumberRoller.Value="{Binding AvgHit}" ctl:NumberRoller.Format="F1"
                                                           FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RbcAccent}"/>
                                                <TextBlock Text="%" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                                            </StackPanel>
                                            <!-- [空值口径 v2] 无连接/无挂载=「—」（禁把 0.0 当数据；S16 口径推广） -->
                                            <TextBlock Text="—" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RbcTextSecondary}"
                                                       Visibility="{Binding KpiHasData, Converter={StaticResource InvertBool}}"/>
                                        </Grid>
                                        <TextBlock Text="已加速卷平均 · 每秒刷新" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="4,0,4,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="本次开机省下磁盘读" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" HorizontalAlignment="Center"/>
                                        <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding KpiHasData, Converter={StaticResource BoolToVis}}">
                                                <TextBlock ctl:NumberRoller.Value="{Binding ServedTotalGB}" ctl:NumberRoller.Format="F1"
                                                           FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RbcSuccessFg}"/>
                                                <TextBlock Text="GB" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                                            </StackPanel>
                                            <!-- [空值口径 v2] 无连接/无挂载=「—」 -->
                                            <TextBlock Text="—" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RbcTextSecondary}"
                                                       Visibility="{Binding KpiHasData, Converter={StaticResource InvertBool}}"/>
                                        </Grid>
                                        <TextBlock Text="缓存读取量累计（本次开机）" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="8,0,0,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="缓存占用与上限" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                            <!-- [A3] 已接线：CacheUsedTotal/CacheCapTotal 全局结构化属性 -->
                                            <ctl:LinkChip Id="A3" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding LinkMode, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                            <!-- [W1.5 S13 用户 17:47] 环心不画数字（Text 留空）；数值走右侧大值列（16→20px） -->
                                            <ctl:UsageRing Width="120" Height="120" Value="{Binding CacheUsedRatio}"/>
                                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding CacheText, Mode=OneWay}" FontFamily="{StaticResource RbcFontMono}" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CacheCapText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding CacheUsedPctText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="各卷配额合计 · 每秒刷新" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- [契约 B-7] 通用操作进度条（卸载回写/预设应用两面包线；二遍读有卡内进度条不在此列）。
                                 有 unmount/preset-apply 进行中（percent<100）时出现，完成即隐藏 -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,0,0,16"
                                    Visibility="{Binding OpProgressVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding OpProgressText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}"/>
                                    <ctl:SmoothProgressBar Value="{Binding OpProgressPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 每卷状态行（徽标 + 状态 + 占用）
                                 [W1.5 截图比对] 对齐原型 .volrow：行卡铺满列表宽（StretchItem）+
                                 盘符/卷标同行横排（.drive 48px + .vlabel 同基线），结论列 * 撑满 -->
                            <TextBlock Text="各卷状态" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding Drives}" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource StretchItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                                CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,12" Margin="0,0,0,12" ctl:CardHover.IsEnabled="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 盘符 + 卷标（原型 .volrow：同行横排，20px/600 盘符 + 12px 卷标） -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding DriveLetter, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Width="40"/>
                                                    <TextBlock Text="{Binding VolumeLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- 徽标药丸（§2.5：Padding 12,4 + 8px 左点 + 12px/600 + 语义底/描边） -->
                                                <Border Grid.Column="1" Padding="12,4" CornerRadius="{StaticResource RbcRadiusMd}" BorderThickness="1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource RbcNeutralBg}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource RbcNeutralBorder}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Mounted}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource RbcSuccessBg}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource RbcSuccessBorder}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ModeIndex}" Value="1">
                                                                    <Setter Property="Background" Value="{StaticResource RbcWarningBg}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource RbcWarningBorder}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource RbcNeutralFg}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Mounted}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource RbcSuccessFg}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ModeIndex}" Value="1">
                                                                            <Setter Property="Fill" Value="{StaticResource RbcWarningFg}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding BadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding BadgeCorner, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding BadgeCorner}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <!-- 结论先行一句话（原型 volrow 单行结构：徽标 + 结论 + 行动，无副文本行） -->
                                                <TextBlock Grid.Column="2" Text="{Binding StatusSentence, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextPrimary}"
                                                           VerticalAlignment="Center" Margin="12,0,12,0" TextWrapping="Wrap"/>
                                                <!-- 行内主行动（跟着结论走） -->
                                                <Button Grid.Column="3" Content="{Binding StatusAction, Mode=OneWay}"
                                                        Command="{Binding DataContext.GoPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding StatusActionPage, Mode=OneWay}"
                                                        Style="{StaticResource BtnGhost}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 空态信息卡（驱动已就绪但零挂载：原型"驱动已就绪，尚未挂到任何卷"） -->
                            <Border Background="{StaticResource RbcInfoBg}" BorderBrush="{StaticResource RbcInfoBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,16" Margin="0,4,0,0"
                                    Visibility="{Binding HasNoVolumes, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="驱动已就绪，尚未挂到任何卷" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RbcInfoFg}"/>
                                        <TextBlock Text="运行首次向导，一分钟完成挂栈与加速选择；系统盘默认不加速。" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="运行首次向导" Command="{Binding RunWizardCommand}" Style="{StaticResource BtnPrimary}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 三段式异常卡（有异常才出现；左竖条 + 结论 + 处置入口） -->
                            <Border Background="{StaticResource RbcWarningBg}" BorderBrush="{StaticResource RbcWarningBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,16" Margin="0,4,0,0"
                                    Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource RbcWarningFg}" CornerRadius="2"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="需要你的注意" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RbcWarningFg}"/>
                                        <TextBlock Text="{Binding PanicStateText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource RbcTextPrimary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DirtyBytesText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0"/>
                                        <Button Content="前往应急处理" Command="{Binding GoEmergencyCommand}" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ============ 加速（每卷配置归一页：配额/预读/写模式同卡；系统卷默认不加速） ============ -->
                <Border x:Name="PageAccel">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PageVisible}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="加速">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- [W1.5 S15 2026-10-23] DockPanel→Grid 三行：原 DockPanel LastChildFill=true 吞掉
                         说明卡的 Dock="Bottom"（其作为最后子元素被当填充元素撑满剩余高度）——图 4 巨大蓝底根因。
                         Grid 三行（Auto 工具行 / * 列表 / Auto 说明卡）语义等价且无此陷阱。 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="加速" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="勾选的卷由缓存加速；配额、预读窗口与写模式都在同一张卡上" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- [设计 v2] 预设来源 chip 收敛到页头（全局状态只渲染一次；原每张卷卡重复） -->
                                <Border Style="{StaticResource RbcSourceChip}" Margin="0,0,12,0"
                                        MouseLeftButtonDown="SourceChip_Click" ToolTip="查看/更改场景预设">
                                    <TextBlock Text="{Binding DataContext.Features.SourceChipText, ElementName=Win}" FontSize="12"
                                               Foreground="{StaticResource RbcTextSecondary}"/>
                                </Border>
                                <Button Content="刷新卷列表" Command="{Binding RefreshDrivesCommand}" Margin="0,0,8,0" Style="{StaticResource BtnSecondary}"
                                        ToolTip="重新枚举固定卷（热插拔/U 盘插入后使用）"/>
                                <Button Content="全部挂载" Command="{Binding MountAllCommand}" Margin="0,0,8,0" Style="{StaticResource BtnSecondary}"/>
                                <Button Content="全部卸载" Command="{Binding UnmountAllCommand}" Style="{StaticResource BtnSecondary}"/>
                            </StackPanel>
                        </Grid>
                        <!-- [FIX B21] 空态：未枚举到固定卷时给原因+下一步（与列表同格叠放，ZIndex 置顶） -->
                        <TextBlock Grid.Row="1" Panel.ZIndex="1" Text="未枚举到固定卷——点右上「刷新卷列表」重试" FontSize="12"
                                   Foreground="{StaticResource RbcTextTertiary}" HorizontalAlignment="Center"
                                   Margin="0,40,0,0" Visibility="{Binding VolumesEmpty, Converter={StaticResource BoolToVis}}"/>
                        <!-- [W1.5 V-6] 首次可见时对 ≤5 容器播装载阶梯（code-behind PlayAccelStagger 消费） -->
                        <ListBox Grid.Row="1" x:Name="AccelDrivesList" ItemsSource="{Binding Drives}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource StretchItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                            CornerRadius="{StaticResource RbcRadiusMd}" Padding="16" Margin="0,0,0,12" MinHeight="64" ctl:CardHover.IsEnabled="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DriveLetter, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding VolumeLabel, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12"/>
                                                <!-- [1:1 原型] 系统卷标签（C: 卡） -->
                                                <TextBlock Text="系统卷 · 默认不加速" FontSize="11" Foreground="{StaticResource RbcWarningFg}" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- [设计对齐] 徽标药丸（§2.5：Padding 12,4 + 左点 + 12px/600）
                                                     [设计 v2] HorizontalAlignment=Left——StackPanel 内默认 Stretch 把 pill 拉满整列（截图实锤） -->
                                                <Border Padding="12,4" CornerRadius="{StaticResource RbcRadiusMd}" BorderThickness="1"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource RbcNeutralBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource RbcNeutralBorder}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Mounted}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource RbcSuccessBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource RbcSuccessBorder}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ModeIndex}" Value="1">
                                                                        <Setter Property="Background" Value="{StaticResource RbcWarningBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource RbcWarningBorder}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{StaticResource RbcNeutralFg}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Mounted}" Value="True">
                                                                                <Setter Property="Fill" Value="{StaticResource RbcSuccessFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ModeIndex}" Value="1">
                                                                                <Setter Property="Fill" Value="{StaticResource RbcWarningFg}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding BadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding BadgeCorner, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding BadgeCorner}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                <!-- [M1/FR-BL-06] 每卷加速/旁路 + 原因码（VOLSTATUS 0x905） -->
                                                <TextBlock Text="{Binding AccelStateText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding AccelText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding UsedText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,2,0,6"/>
                                                <ctl:SmoothProgressBar Value="{Binding UsedPct, Mode=OneWay}" Maximum="100" Height="6"/>
                                                <TextBlock Text="配额 (MB)" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,8,0,2"/>
                                                <Slider Minimum="64" Maximum="4096" TickFrequency="64" IsSnapToTickEnabled="True"
                                                        Value="{Binding QuotaMB, Mode=TwoWay}"/>
                                                <!-- [D1] 每卷配额/模式重启后恢复默认（settings.json 无每卷键，随 W2-3 配置面产品化） -->
                                                <ctl:LinkChip Id="D1" Width="28" Height="16" Margin="0,2,0,0" HorizontalAlignment="Left"
                                                              Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <!-- [W1.5 S17 用户 23:43] 线图反馈全部置顶（读+写两条 sparkline），数字下移 -->
                                                <ctl:Sparkline Height="48" Value="{Binding ReadMbps, Mode=OneWay}"/>
                                                <ctl:Sparkline Height="48" Value="{Binding WriteMbps, Mode=OneWay}" Stroke="{StaticResource RbcSuccessFg}" Margin="0,4,0,0"/>
                                                <!-- [W1.5 S14 2026-10-23] 指标两行对齐设计稿：读/写同行 + 命中独立行（原缺写值）
                                                     [空值口径 S16] 未挂载卷文本走 ReadText/WriteText/HitText（"—"，禁 0.0 误导） -->
                                                <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,8,0,0">
                                                    <Run Text="读 "/><Run Text="{Binding ReadText, Mode=OneWay}"/><Run Text=" MB/s   写 "/>
                                                    <Run Text="{Binding WriteText, Mode=OneWay}"/><Run Text=" MB/s"/>
                                                </TextBlock>
                                                <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,2,0,0">
                                                    <Run Text="命中 "/><Run Text="{Binding HitText, Mode=OneWay}"/><Run Text="%"/>
                                                </TextBlock>
                                                <!-- [BUG3] 缓存证据行：本次开机累计缓存读取量（"缓存在工作"的可见证明） -->
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding ServedText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12"/>
                                                    <!-- [A6] 已接线：ServedBytes 数值源（DriveItemViewModel）→ 状态页 KPI -->
                                                    <ctl:LinkChip Id="A6" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <!-- [设计 v2] 预设来源 chip 移至页头工具行（全局预设状态每卡重复渲染=噪音） -->
                                                <!-- 写模式（原型 ctl-col 第一项；P1-11：默认直写，回写需知情） -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="写模式" Width="52" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                    <ComboBox Width="126" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" SelectionChanged="ManagedField_Changed">
                                                        <ComboBoxItem Content="直写（最安全）"/>
                                                        <ComboBoxItem Content="回写（更快·有风险）"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <!-- [W1.5/R2] 回写风险一句话（DriveItemViewModel.WriteModeHint；直写时为空串自动隐藏） -->
                                                <TextBlock Text="{Binding WriteModeHint, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}"
                                                           FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WriteModeHint}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- [FR-PF-02] 每卷预读窗口（原型 ctl-col 第二项） -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                                    <TextBlock Text="预读" Width="52" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                    <ComboBox Width="126" SelectedIndex="{Binding ReadAheadIndex, Mode=TwoWay}" SelectionChanged="ManagedField_Changed">
                                                        <ComboBoxItem Content="关闭"/>
                                                        <ComboBoxItem Content="8 MB"/>
                                                        <ComboBoxItem Content="16 MB"/>
                                                        <ComboBoxItem Content="32 MB"/>
                                                        <ComboBoxItem Content="64 MB"/>
                                                    </ComboBox>
                                                    <!-- [C5] IPrefetchGate：预取激活前置条件门随 W3-3 消费方重建 -->
                                                    <ctl:LinkChip Id="C5" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <!-- [W1.5/R7] 预读一句话说明（DriveItemViewModel.ReadAheadHint 随档位联动） -->
                                                <TextBlock Text="{Binding ReadAheadHint, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}"
                                                           FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                <!-- 加速开关（原型 ctl-col 主控件：勾选=挂载加速；替换原挂载按钮） -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                                    <!-- [FIX D#12] 系统卷置灰（CanAccel=False）：驱动硬排除，避免"点了没反应" -->
                                                    <ToggleButton IsChecked="{Binding AccelSwitch, Mode=TwoWay}" IsEnabled="{Binding CanAccel}" Style="{StaticResource SwitchToggle}"/>
                                                    <TextBlock Text="加速" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- ctl-reason（系统卷/禁用原因，卡外文案） -->
                                                <TextBlock Text="{Binding CtlReason, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,0,0,6" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CtlReason}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- 卸载 / 立即回写（原型按钮行） -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                                    <Button Content="卸载" Command="{Binding UnmountCommand}" Width="60" Style="{StaticResource BtnSecondary}"/>
                                                    <Button Content="立即回写" Command="{Binding FlushCommand}" Width="84" Margin="6,0,0,0" Style="{StaticResource BtnSecondary}"/>
                                                    <!-- [C1] IOperationProgress：卸载/回写进度可见随 W1-2 消费方重建 -->
                                                    <ctl:LinkChip Id="C1" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <!-- [设计 v2] 「暂停/恢复」按钮移除：驱动无逐卷暂停能力
                                                     （DriverService.Pause 仅记 WARN 忽略）——点了没反应的死 UI 必须删除 -->
                                                <TextBlock Text="驱动不支持逐卷暂停；盘面异常请用「应急」页熔断" FontSize="11"
                                                           Foreground="{StaticResource RbcTextTertiary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 系统卷说明卡（信息卡：C: 默认不加速的原因 + B-10 opt-in 入口）
                             [W1.5 S15 用户 17:47 质问"这么大个蓝底还不能 × 掉"→ 右上加 × 关闭（会话级，
                             重启恢复）；Grid.Row=2 按内容高，不再被 DockPanel 填充陷阱撑满 -->
                        <Border Grid.Row="2" Background="{StaticResource RbcInfoBg}" BorderBrush="{StaticResource RbcInfoBorder}" BorderThickness="1"
                                CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,12" Margin="0,4,0,0"
                                Visibility="{Binding SysVolCardVisible, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="系统卷（C:）默认不加速" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RbcInfoFg}"/>
                                        <!-- [C4] ISystemVolumeOptIn：B-10 三段式确认流已建（协议 SET_CONFIG 在位） -->
                                        <ctl:LinkChip Id="C4" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                      Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <!-- [B-10] opt-in 入口（三段式确认 + 确认记录；系统卷强制直写） -->
                                        <Button Content="手动开启" Command="{Binding DataContext.Features.SystemVolumeOptInCommand, ElementName=Win}"
                                                Style="{StaticResource BtnSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="为避免影响系统稳定性，安装有 Windows 的卷默认不纳入缓存。确有必要时点「手动开启」——将弹三段式确认；系统卷纳入后强制直写（永不回写），掉电无未落盘风险。数据卷可正常加速。" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕" Style="{StaticResource BtnGhost}" Width="28" MinHeight="28" Padding="0"
                                        Command="{Binding SysVolCardCloseCommand}" VerticalAlignment="Top"
                                        ToolTip="收起本提示（重启后恢复）"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ 收益（缓存为你做了什么：每卷收益 + 特性层价值计数） ============ -->
                <Border x:Name="PageGain">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PageVisible}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="收益">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="收益" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="缓存为你做了什么：一级看三个数，二级看细节（默认折叠）。" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 一级 3 KPI（转译映射要求：平均命中率/省下磁盘读/缓存占用 used/cap）
                                 [W1.5 D6] KPI2/KPI3 大值规格与状态页统一（32px NumberRoller/mono + 单位分排；红线 8 数字纪律）
                                 [W1.5 S13 用户 17:47] 卡内容整体居中（与状态页 KPI 同构） -->
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,0,8,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="平均缓存命中率" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" HorizontalAlignment="Center"/>
                                        <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding KpiHasData, Converter={StaticResource BoolToVis}}">
                                                <TextBlock ctl:NumberRoller.Value="{Binding AvgHit}" ctl:NumberRoller.Format="F1"
                                                           FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RbcAccent}"/>
                                                <TextBlock Text="%" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                                            </StackPanel>
                                            <!-- [空值口径 v2] 无连接/无挂载=「—」（禁把 0.0 当数据；S16 口径推广） -->
                                            <TextBlock Text="—" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RbcTextSecondary}"
                                                       Visibility="{Binding KpiHasData, Converter={StaticResource InvertBool}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="4,0,4,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="本次开机省下的磁盘读" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" HorizontalAlignment="Center"/>
                                        <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding KpiHasData, Converter={StaticResource BoolToVis}}">
                                                <TextBlock ctl:NumberRoller.Value="{Binding ServedTotalGB}" ctl:NumberRoller.Format="F1"
                                                           FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RbcSuccessFg}"/>
                                                <TextBlock Text="GB" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                                            </StackPanel>
                                            <!-- [空值口径 v2] 无连接/无挂载=「—」 -->
                                            <TextBlock Text="—" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RbcTextSecondary}"
                                                       Visibility="{Binding KpiHasData, Converter={StaticResource InvertBool}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="8,0,0,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="缓存占用（已用 / 配额）" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CacheText, Mode=OneWay}" FontSize="32" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource RbcFontMono}" Foreground="{StaticResource RbcSuccessFg}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- 图表 bento（span2 大图布局，对齐原型：命中率/吞吐/分片各占两格，右列环/构成/堆叠） -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 行 0：冷热二遍读对比卡（C-3 通栏英雄位：V10.6「可信」支柱证据工具；B-4/B-5 未就绪=降级横幅+演示数据） -->
                                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource RbcBenchmarkCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="冷热对比" FontSize="14" FontWeight="SemiBold"/>
                                            <!-- [B-4] 二遍读基准执行体：CLI 同款测量代码路径 + 误差<2% 硬契约（移交后端） -->
                                            <ctl:LinkChip Id="B-4" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                            <!-- 降级横幅（B-5 FlushFileRange 未就绪：第一遍可能不是冷读，结果仅供参考） -->
                                            <Border Style="{StaticResource RbcDegradeBanner}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding DataContext.Features.BenchDegraded, ElementName=Win, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="缓存范围刷新能力不可用（B-5 待后端），第一遍可能不是冷读，结果仅供参考" FontSize="11" Foreground="{StaticResource RbcWarningFg}"/>
                                            </Border>
                                            <Button Content="取消" Command="{Binding DataContext.Features.CancelBenchmarkCommand, ElementName=Win}"
                                                    HorizontalAlignment="Right" Margin="16,0,0,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.Features.BenchRunning, ElementName=Win}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <!-- 空态：24px 线性图标 + 引导文案（06 C-3.5/C-3.6 原文；图标为非信息装饰 → tertiary 合规） -->
                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding DataContext.Features.BenchState, ElementName=Win, Converter={StaticResource BenchStateVis}, ConverterParameter=empty}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M 3,12 L 3,20 M 8,12 L 8,20 M 1,20 L 10,20 M 14,5 L 14,20 M 19,5 L 19,20 M 12,20 L 21,20"
                                                      Stroke="{StaticResource RbcTextTertiary}" StrokeThickness="1.5" HorizontalAlignment="Left"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                <TextBlock Text="选择文件，对比磁盘读取与缓存读取的速度" FontSize="13" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="建议选择 512 MB 以上的文件，且所在卷已加速"
                                                       FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <Button Content="选择文件" Command="{Binding DataContext.Features.SelectBenchFileCommand, ElementName=Win}"
                                                    Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                        </StackPanel>
                                        <!-- 校验中 / 文件就绪：路径 + 信息 + 开始对比 -->
                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding DataContext.Features.BenchState, ElementName=Win, Converter={StaticResource BenchStateVis}, ConverterParameter=fileready}">
                                            <TextBlock Text="{Binding DataContext.Features.BenchFilePath, ElementName=Win}" FontSize="12" FontFamily="{StaticResource RbcFontMono}"
                                                       Foreground="{StaticResource RbcTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding DataContext.Features.BenchFileInfo, ElementName=Win}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                                <Button Content="开始对比" Command="{Binding DataContext.Features.RunBenchmarkCommand, ElementName=Win}"
                                                        Style="{StaticResource BtnPrimary}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- 校验中（Validating 300ms） -->
                                        <TextBlock Text="正在校验文件…" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,12,0,0"
                                                   Visibility="{Binding DataContext.Features.BenchState, ElementName=Win, Converter={StaticResource BenchStateVis}, ConverterParameter=validating}"/>
                                        <!-- 运行态：进度 + 阶段文案 -->
                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding DataContext.Features.BenchState, ElementName=Win, Converter={StaticResource BenchStateVis}, ConverterParameter=running}">
                                            <TextBlock Text="{Binding DataContext.Features.BenchStageText, ElementName=Win}" FontSize="12" Foreground="{StaticResource RbcTextPrimary}"/>
                                            <ctl:SmoothProgressBar Value="{Binding DataContext.Features.BenchPercent, ElementName=Win, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <!-- 结果态：对比表 + 提升徽标 + 双条形
                                             [W1.5 D5/D17] 大值 32px mono + 第二遍 accent（V-4 主指标）+ 盘速/缓存速口径（I-08） -->
                                        <Grid Margin="0,12,0,0"
                                              Visibility="{Binding DataContext.Features.BenchState, ElementName=Win, Converter={StaticResource BenchStateVis}, ConverterParameter=result}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="第一遍 · 盘速" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DataContext.Features.BenchFirstMbps, ElementName=Win, StringFormat=F0}" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource RbcFontMono}"/>
                                                        <TextBlock Text=" MB/s" FontSize="13" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,8"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DataContext.Features.BenchFirstSec, ElementName=Win, StringFormat=F2}" FontSize="13" FontFamily="{StaticResource RbcFontMono}"
                                                               Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="第二遍 · 缓存速" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DataContext.Features.BenchSecondMbps, ElementName=Win, StringFormat=F0}" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource RbcFontMono}" Foreground="{StaticResource RbcAccent}"/>
                                                        <TextBlock Text=" MB/s" FontSize="13" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,8"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DataContext.Features.BenchSecondSec, ElementName=Win, StringFormat=F2}" FontSize="13" FontFamily="{StaticResource RbcFontMono}"
                                                               Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <!-- [C-3 解锁 2026-10-24] 完整结果表第三行：读取量 + 第二遍命中率
                                                     （B-4 真数据已接线；驱动不可测/演示态=「—」不造假，红线 8） -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="读取量（两遍同一文件）" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DataContext.Features.BenchBytesText, ElementName=Win}" FontSize="13" FontFamily="{StaticResource RbcFontMono}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="命中率 " FontSize="12" Foreground="{StaticResource RbcTextSecondary}"/>
                                                        <TextBlock Text="{Binding DataContext.Features.BenchHitRateText, ElementName=Win}" FontSize="13" FontFamily="{StaticResource RbcFontMono}" Foreground="{StaticResource RbcAccent}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <!-- [W1.5 D17/D19] 口径声明（常驻，11px secondary——信息性文本禁 tertiary）+
                                                     免责小字（06 C-3.6 原文；演示态口径如实标注 B-4 未就绪，不冒充） -->
                                                <TextBlock FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="同一文件 · 同样读法 · 绕过系统缓存 · 与 ramboostctl stats 同口径（误差 &lt;2%）"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.Features.BenchDegraded, ElementName=Win}" Value="True">
                                                                    <Setter Property="Text" Value="演示数据（B-4 执行体未就绪）· 就绪后：同一文件 · 同样读法 · 绕过系统缓存 · 与 ramboostctl stats 同口径（误差 &lt;2%）"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="结果随文件大小与磁盘状态变化，建议多跑几次取稳定值"
                                                           FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <!-- [W1.5 审查 P2#3] 提升徽标对齐 06 C-3.2：中文段 13/600 + 数字段 13/600 mono +
                                                     右段「耗时 -N%」13 secondary（原 20px 单值不符合徽标规格） -->
                                                <Border Background="{StaticResource RbcSuccessBg}" BorderBrush="{StaticResource RbcSuccessBorder}" BorderThickness="1"
                                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="12,4" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="缓存加速" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RbcSuccessFg}"/>
                                                        <TextBlock Text="{Binding DataContext.Features.BenchSpeedupText, ElementName=Win}" FontSize="13" FontWeight="SemiBold"
                                                                   FontFamily="{StaticResource RbcFontMono}" Foreground="{StaticResource RbcSuccessFg}" Margin="6,0,0,0"/>
                                                        <TextBlock FontSize="13" Foreground="{StaticResource RbcTextSecondary}" Margin="8,0,0,0">
                                                            <Run Text="耗时 -"/><Run Text="{Binding DataContext.Features.BenchTimeSavedPct, ElementName=Win, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <ctl:DualBarCompare x:Name="BenchBars" Width="160" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- 行 1：命中率趋势（span2 大图） + 占用环 -->
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,12,8,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="读命中率趋势（最近 5 分钟）" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                            <!-- [A1] 已接线：StatsService 采样 → 60×5s 环形缓冲 -->
                                            <ctl:LinkChip Id="A1" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="读 = 命中率" FontSize="11" Foreground="{StaticResource RbcTextTertiary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </StackPanel>
                                        <ctl:HitRateChart Height="190" Margin="0,8,0,0" Series="{Binding HitSeries}" EmptyText="{Binding SeriesEmptyText}"/>
                                        <TextBlock Text="口径：最近 5 分钟 · 60 采样点（5s 一点）· 采样中断处断线留缺口、不插值" FontSize="11" Foreground="{StaticResource RbcTextTertiary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="8,0,0,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="缓存占用与上限" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <!-- [A3] 已接线：CacheUsedTotal/CacheCapTotal 全局结构化属性 -->
                                            <ctl:LinkChip Id="A3" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <ctl:UsageRing Width="160" Height="160" Margin="0,8,0,0" HorizontalAlignment="Center"
                                                       Value="{Binding CacheUsedRatio}" Text="{Binding CacheUsedText, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding CacheCapText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CacheUsedPctText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="口径：已用 / 配额（MB）· 环心为已用值；超配额时环体变琥珀" FontSize="11" Foreground="{StaticResource RbcTextTertiary}" Margin="0,6,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- 行 2：读写吞吐（span2 大图） + 写模式构成 -->
                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,12,8,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="读写吞吐" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                            <!-- [A2] 已接线：ReadMbps/WriteMbps 汇总 → 双序列缓冲 -->
                                            <ctl:LinkChip Id="A2" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource RbcChart1}"/>
                                                <TextBlock Text="读" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="4,0,12,0"/>
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource RbcChart2}"/>
                                                <TextBlock Text="写" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ctl:ThroughputChart Height="190" Margin="0,8,0,0" ReadSeries="{Binding ReadSeries}" WriteSeries="{Binding WriteSeries}" EmptyText="{Binding SeriesEmptyText}"/>
                                        <TextBlock Text="口径：MB/s · Y 自适应（按序列峰值）· 读 = chart-1 青 / 写 = chart-2 深青" FontSize="11" Foreground="{StaticResource RbcTextTertiary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="8,12,0,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="写模式构成" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                            <!-- [A4] 已接线：Drives.Mode 纯 UI 派生，无协议缺口 -->
                                            <ctl:LinkChip Id="A4" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <ctl:SegmentedBar Height="10" Margin="0,10,0,0" Segments="{Binding WriteModeSegments}" Total="{Binding WriteModeTotal}"
                                                          EmptyText="尚未加速任何卷"/>
                                        <TextBlock Text="{Binding WriteModeSummaryText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="绿 = 直写（最安全）· 琥珀 = 回写（更快·有未落盘风险）。" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- 行 3：分片吞吐热力（span2 大图） + 未落盘堆叠 -->
                                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,12,8,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="分片吞吐热力（最近 5 秒）" FontSize="12" Foreground="{StaticResource RbcTextSecondary}"/>
                                            <TextBlock Text="{Binding StripePeakText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource RbcTextSecondary}" FontSize="12"/>
                                        </Grid>
                                        <!-- [B1] 已接线：RbStats.StripeRead/Write[64]（协议已有，UI 周期增量→峰值归一） -->
                                        <ctl:LinkChip Id="B1" Width="28" Height="16" Margin="0,2,0,0" HorizontalAlignment="Left"
                                                      Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <ctl:StripeHeatmap Height="110" Margin="0,8,0,0"
                                                           ReadValues="{Binding StripeHeatRead}" WriteValues="{Binding StripeHeatWrite}"
                                                           EmptyText="{Binding SeriesEmptyText}"/>
                                        <TextBlock Text="每格 = 磁盘一个分片的本周期吞吐（读上行 / 写下行，按各自峰值上色）；可见负载是否均匀铺开。" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="8,12,0,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="未落盘数据量" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center"/>
                                            <!-- [B2] 已接线：DirtyBytes/LostDirtyBytes（协议已有，应急页同源） -->
                                            <ctl:LinkChip Id="B2" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <ctl:SegmentedBar Height="10" Margin="0,10,0,0" Segments="{Binding DirtySegments}" Total="{Binding DirtyStackTotal}"
                                                          EmptyText="暂无未落盘数据"/>
                                        <TextBlock Text="{Binding DirtyStackText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="红段 = 已确认丢失 · 琥珀 = 未落盘（掉电可能丢失）；相对缓存上限占比。" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 每卷收益列表（[W1.5 截图比对] 行卡铺满列表宽） -->
                            <TextBlock Text="各卷省下的磁盘读" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding Drives}" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource StretchItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                                CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,12" Margin="0,0,0,12" ctl:CardHover.IsEnabled="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DriveLetter, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ServedText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource RbcSuccessFg}"/>
                                                    <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,2,0,0">
                                                        <Run Text="命中率 "/><Run Text="{Binding HitPct, Mode=OneWay, StringFormat=F1}"/><Run Text="%"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <ctl:Sparkline Grid.Column="2" Height="48" Value="{Binding ReadMbps, Mode=OneWay}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 二级明细（Expander 默认折叠 5 行：L2/预取/温度护栏/进程准入/平均延迟；配置入口在设置页） -->
                            <Expander IsExpanded="False" Margin="0,8,0,0">
                                <Expander.Header>
                                    <TextBlock Text="二级明细（默认折叠）" FontSize="14" FontWeight="SemiBold"/>
                                </Expander.Header>
                                <StackPanel Margin="0,4,0,0">
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                            CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,0,8,0" ctl:CardHover.IsEnabled="True">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="L2 持久缓存（掉电保留）" FontSize="13" FontWeight="SemiBold"/>
                                                <!-- [C2] IL2RecoveryReporter：L2 掉电恢复重建事件 UI 化随 W2 消费方重建 -->
                                                <ctl:LinkChip Id="C2" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                              Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding L2StateText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding L2CountersText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcSuccessFg}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                            CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="8,0,0,0" ctl:CardHover.IsEnabled="True">
                                        <StackPanel>
                                            <TextBlock Text="顺序读预取" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PrefetchCountersText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcSuccessFg}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ThermalText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <!-- 温度护栏 / 进程准入 / 平均延迟（延迟行已接 B-12 真值；无样本显示「—」不画假数据）
                                     [设计 v2] 三张单行卡收进一行三列——原全宽纵排把明细撑出三屏高（密度失衡） -->
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,12" Margin="0,0,8,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel>
                                        <TextBlock Text="温度护栏（FR-PF-03）" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ThermalText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,12" Margin="0,0,8,0" ctl:CardHover.IsEnabled="True">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="进程准入排除（FR-BL-03）" FontSize="13" FontWeight="SemiBold"/>
                                            <!-- [A6 类] AdmitRejects 已接线计数；名单编辑在设置页 -->
                                            <ctl:LinkChip Id="A6" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AdmitRejectsText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0"/>
                                        <TextBlock Text="名单配置入口：设置页 → 进程准入排除" FontSize="11" Foreground="{StaticResource RbcTextTertiary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,12" ctl:CardHover.IsEnabled="True">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="平均延迟" FontSize="13" FontWeight="SemiBold"/>
                                            <!-- [B-12 已接线 2026-10-24] RbStats 读延迟 EWMA 字段交付：真值随采样 tick 刷新；
                                                 无样本/离线显示「—」（无字段不画假值纪律）——B3 待驱动角标随之移除 -->
                                        </StackPanel>
                                        <TextBlock Text="{Binding LatencyDetailText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                </UniformGrid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ============ 诊断（日志自动拉取 + 版本单轨；自检/导出随 W1-2 扩展） ============ -->
                <Border x:Name="PageDiag">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PageVisible}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="诊断">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="诊断" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="进入本页自动拉取驱动日志；驱动侧原始字段仅在本页可见" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- [§5 转译映射：进页自动拉日志（SelectedPage 变更即触发），去手动按钮] -->
                            <Button Content="导出诊断信息" Command="{Binding ExportDiagCommand}" Style="{StaticResource BtnSecondary}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    ToolTip="把版本/自检/IOCTL 通道/日志导出为文本（D2）"/>
                        </Grid>
                        <!-- [设计 v2 2026-10-24] 日志区升为主列（*）——原 DockPanel 三张 Bottom 卡把
                             日志填充区挤到 0 高（诊断页核心内容不可见，截图实锤）；侧栏卡收进右列 380 纵叠 -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource RbcBgApp}" CornerRadius="{StaticResource RbcRadiusMd}" Padding="12" BorderThickness="0">
                            <Grid>
                                <!-- [FIX B21] 空态：暂无日志时说明本页会自动拉取+导出入口（与列表同格叠放） -->
                                <TextBlock Text="暂无日志——进入本页会自动拉取驱动日志，也可点「导出诊断信息」" FontSize="12"
                                           Foreground="{StaticResource RbcTextTertiary}" HorizontalAlignment="Center"
                                           Margin="0,24,0,0" Visibility="{Binding LogEmpty, Converter={StaticResource BoolToVis}}"/>
                                <ListBox ItemsSource="{Binding LogLines}" FontFamily="{StaticResource RbcFontMono}" FontSize="12"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource RbcTextSecondary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="IOCTL 通道健康（12 消息）" FontSize="13" FontWeight="SemiBold"/>
                                            <!-- [A5] 已接线：DriverService 收口埋点（DriverService.IoctlTrace），纯用户态零协议改动 -->
                                            <ctl:LinkChip Id="A5" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Text="绿=正常 · 琥珀=偏慢（≥50ms）· 红=失败 · 灰=未调用；联调归因先看这里。" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,8"/>
                                        <ctl:IoctlMatrix Height="120" Items="{Binding IoctlHealth}"/>
                                    </StackPanel>
                                </Border>
                                <!-- [D2] 自检清单（驱动真相缓存；✓/✕ + 文案双通道，不单靠颜色） -->
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="自检清单" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding DiagChecks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="mark" Grid.Column="0" Width="20" FontSize="13" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource RbcSuccessFg}" Text="✓"/>
                                                        <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" Text="{Binding Name}"/>
                                                        <TextBlock Grid.Column="2" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" Text="{Binding Detail}"/>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                                            <Setter TargetName="mark" Property="Foreground" Value="{StaticResource RbcDangerFg}"/>
                                                            <Setter TargetName="mark" Property="Text" Value="✕"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="版本与协议" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" LineHeight="20">
                                            <Run Text="控制台 "/><Run Text="{Binding ProductVersion, Mode=OneWay}" /><LineBreak/>
                                            <Run Text="{Binding TitleExtra, Mode=OneWay}" /><LineBreak/>
                                            <Run Text="协议 9 · IOCTL 0x222000 · 设备按盘符 · 结构体 Pack=8" /><LineBreak/>
                                            <Run Text="缓存块 4K 对齐 · 读写全进内存 · 动态内存自适应（有多少用多少、不写死上限）" /><LineBreak/>
                                            <Run Text="系统卷/引导关键卷硬排除 · panic 熔断自动旁路" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ============ 应急（异常处置唯一入口：熔断护栏 / 解除 / 安全模式 / 核对 / 回滚） ============ -->
                <Border x:Name="PageEmergency">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PageVisible}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="应急">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="应急" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="出问题时的退路都在这：熔断、安全模式、未落盘核对、回滚指引、救援卡。" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 顶部态势卡（无异常=信息卡；有异常=三段式异常卡，与状态页同构） -->
                            <Border Background="{StaticResource RbcInfoBg}" BorderBrush="{StaticResource RbcInfoBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,16" Margin="0,0,0,12"
                                    Visibility="{Binding HasNoIssues, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource RbcInfoFg}" CornerRadius="2"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="当前无异常" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RbcInfoFg}"/>
                                        <TextBlock Text="无需应急操作。异常出现时，顶部状态条「风险」段会变色并一键回到本页。" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource RbcWarningBg}" BorderBrush="{StaticResource RbcWarningBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,16" Margin="0,0,0,12"
                                    Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource RbcWarningFg}" CornerRadius="2"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="需要你的注意" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource RbcWarningFg}"/>
                                        <TextBlock Text="{Binding PanicStateText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource RbcTextPrimary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DirtyBytesText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 危险操作收口（原型 danger-zone：三段式确认，不做默认焦点） -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcDangerBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="危险操作（均带三段式确认，不做默认焦点）" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource RbcDangerFg}"/>
                                    <TextBlock Text="盘面异常（磁盘报错、数据可疑）时先熔断保数据；解除熔断必须等自愈完成。" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,8,0">
                                            <Button Content="一键熔断" Command="{Binding PanicCommand}" Style="{StaticResource BtnDanger}" HorizontalAlignment="Stretch"/>
                                            <TextBlock Text="{Binding PanicReasonText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Margin="4,0,4,0">
                                            <Button Content="解除熔断" Command="{Binding PanicClearCommand}" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanPanicClear}"/>
                                            <TextBlock Text="{Binding PanicClearReasonText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <Button Content="退出安全模式" Command="{Binding ExitSafeModeCommand}" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Stretch"/>
                                            <TextBlock Text="{Binding SafeModeReasonText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- 未落盘与丢失量核对（原型：明细 + 磁盘检查 + 立即回写全部） -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,16" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="未落盘与丢失量核对" FontSize="14" FontWeight="SemiBold"/>
                                        <!-- [B2] 已接线：DirtyBytes/LostDirtyBytes（协议已有，状态条同源） -->
                                        <ctl:LinkChip Id="B2" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                      Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <!-- [C-7/A-12] 电源 chip（有回写卷时常驻；与 F3 对话框同 Key 同口径。
                                             [W1.5 D9/D10/D11] DataContext=Features 修复三态变色 + 补 HasWritebackVolume 条件 + 百分比等宽段 -->
                                        <Border Style="{StaticResource RbcPowerStateChip}" DataContext="{Binding Features}" Margin="16,0,0,0"
                                                Visibility="{Binding DataContext.HasWritebackVolume, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource RbcPowerStateDot}"/>
                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12">
                                                    <Run Text="{Binding PowerStateLabel, Mode=OneWay}"/><Run Text="{Binding PowerStatePct, Mode=OneWay}" FontFamily="{StaticResource RbcFontMono}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <!-- [设计 v2] 0=正常态：中性色（原恒 warning 黄把正常当警示）；有未落盘才转警示色 -->
                                    <TextBlock Text="{Binding DirtyBytesText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource RbcWarningFg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DirtyBytesText}" Value="无未落盘数据">
                                                        <Setter Property="Foreground" Value="{StaticResource RbcTextPrimary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DirtyDetailText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding LostDirtyVisible, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding LostDirtyText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RbcWarningFg}"/>
                                        <TextBlock Text="异常退出时未能落盘的量——已由驱动如实记账，不会静默丢弃。" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="打开磁盘错误检查" Command="{Binding DiskCheckCommand}" Style="{StaticResource BtnGhost}"/>
                                        <Button Content="立即回写全部" Command="{Binding FlushAllCommand}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 回滚指引（原型三步图：熔断 → 卸载 → 重启后按需重开） -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="回滚指引（出问题时的完整退路）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <UniformGrid Columns="5">
                                        <StackPanel Margin="0,0,8,0">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource RbcDangerSolid}" HorizontalAlignment="Left">
                                                <TextBlock Text="1" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="一键熔断" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <TextBlock Text="读写直接到盘，缓存暂停；未落盘数据由驱动继续写盘。任何盘面异常的第一步。" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="→" FontSize="20" Foreground="{StaticResource RbcTextTertiary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <StackPanel Margin="0,0,8,0">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource RbcBgElevated}" HorizontalAlignment="Left">
                                                <TextBlock Text="2" Foreground="{StaticResource RbcTextPrimary}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="卸载缓存卷" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <TextBlock Text="在加速页逐卷卸载，驱动自动回写脏数据后再摘除；卸载中请勿直接拔盘或强关。" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="→" FontSize="20" Foreground="{StaticResource RbcTextTertiary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <StackPanel Margin="0,0,0,0">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource RbcBgElevated}" HorizontalAlignment="Left">
                                                <TextBlock Text="3" Foreground="{StaticResource RbcTextPrimary}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="重启后按需重开" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <TextBlock Text="重启后从设置页卸载或重跑首次向导；每卷配置会恢复默认（持久化随 W2-3 落地）。" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- 导出救援卡（原型：状态/版本/自检/日志打包，找人帮忙时直接发） -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="16,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="导出救援卡" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="把当前状态、版本、自检结果、日志打包成一个文件，找人帮忙时直接发它。" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="导出救援卡" Command="{Binding ExportDiagCommand}" Style="{StaticResource BtnSecondary}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ============ 设置（启动项 / 缓存策略 / 进程准入 / 预留与实验 / 卸载 / 关于） ============ -->
                <Border x:Name="PageSettings">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PageVisible}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="设置">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <!-- 启动项 -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}">
                                <StackPanel>
                                    <TextBlock Text="启动" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <CheckBox Content="开机自动随卷挂载（跳过系统盘 C:）" IsChecked="{Binding AutoStart}"
                                              Foreground="{StaticResource RbcTextPrimary}" FontSize="13"/>
                                    <CheckBox Content="随 Windows 启动本控制台" IsChecked="{Binding LaunchOnBoot}"
                                              Foreground="{StaticResource RbcTextPrimary}" FontSize="13" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ═══ V10.6 F1 场景预设卡（设置页第一张功能卡；06 C-1）═══
                                 [W1.5 D16] 对齐 C-1 规范结构：档位说明行 + 恢复默认说明行 + ComboBox 220 +
                                 摘要表默认折叠 + 差异条条件折叠；[D10] 语义条 DataContext=Features（修复四档变色） -->
                            <Border Style="{StaticResource RbcPresetCard}" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 三档语义条（3px；R-1 裁定：档位标识≠状态表达） -->
                                    <Border Grid.Column="0" Style="{StaticResource RbcPresetTierBar}" DataContext="{Binding Features}" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="场景预设" FontSize="14" FontWeight="SemiBold"/>
                                            <!-- [A-9] F1 预设：ApplyPreset 编排移交后端（B-3）；前端退化方案=逐字段 SET_CONFIG+回滚 -->
                                            <ctl:LinkChip Id="A-9" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding LinkMode, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Text="按使用场景一键配置缓存参数，之后仍可手动微调"
                                                   FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0"/>
                                        <!-- 预设选择（四值；VM 为真相源，应用后自动同步；选中即应用无保存按钮 C-1.4） -->
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="档位" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="PresetCombo" Width="220" VerticalAlignment="Center"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding DataContext.Features.PresetTier, ElementName=Win, Mode=OneWay}"
                                                      SelectionChanged="PresetCombo_SelectionChanged"
                                                      IsEnabled="{Binding DataContext.Features.PresetApplying, ElementName=Win, Converter={StaticResource InvertBool}}">
                                                <ComboBoxItem Content="安全 · 只读" Tag="safe"/>
                                                <ComboBoxItem Content="均衡 · 读写" Tag="balanced"/>
                                                <ComboBoxItem Content="性能 · 回写" Tag="perf"/>
                                                <ComboBoxItem Content="自定义" Tag="custom"/>
                                            </ComboBox>
                                            <Button Content="恢复默认" Command="{Binding DataContext.Features.RestorePresetDefaultCommand, ElementName=Win}"
                                                    Style="{StaticResource BtnSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- 恢复默认影响说明（06 C-1.7 原文） -->
                                        <TextBlock Text="将把受管参数恢复为『均衡 · 读写』标称值；每卷配额、挂栈状态与自定义排除名单不受影响"
                                                   FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <!-- 档位说明（随档位切换，06 C-1.7 四档文案） -->
                                        <TextBlock Text="{Binding DataContext.Features.PresetTierDesc, ElementName=Win}"
                                                   FontSize="13" Foreground="{StaticResource RbcTextSecondary}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                        <!-- 差异条（自定义态条件渲染；折叠展开差异清单） -->
                                        <Expander Margin="0,12,0,0"
                                                  Visibility="{Binding DataContext.Features.HasPresetDiff, ElementName=Win, Converter={StaticResource BoolToVis}}">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding DataContext.Features.PresetDiffHeaderText, ElementName=Win}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RbcWarningFg}"/>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding DataContext.Features.PresetDiff, ElementName=Win}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource RbcWarningFg}" Margin="0,1,0,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                        <!-- 受管参数摘要表（默认折叠，06 C-1.1「▾ 受管参数（7）」） -->
                                        <Expander IsExpanded="False" Margin="0,12,0,0">
                                            <Expander.Header>
                                                <TextBlock Text="受管参数（7）" FontSize="13" FontWeight="SemiBold"/>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding DataContext.Features.PresetSummary, ElementName=Win}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="160"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontFamily="{StaticResource RbcFontMono}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 缓存策略（L2 / 预取 / 回写周期，从原缓存页下沉） -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="缓存策略" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <!-- L2 持久缓存（FR-L2-03 配置面 / FR-L2-06 统计） -->
                                    <Grid>
                                        <TextBlock Text="L2 持久缓存" FontWeight="SemiBold" Foreground="{StaticResource RbcTextPrimary}" FontSize="13"/>
                                        <TextBlock Text="{Binding L2StateText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource RbcTextSecondary}" FontSize="12"/>
                                    </Grid>
                                    <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"
                                               Text="掉电重启后仍保留的热数据（「开机即热」）。启用后驱动在选中卷创建容器文件 RAMBoostL2.bin，该空间被缓存专用；删除缓存 = 删除该文件。"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                                            <TextBlock Text="容器盘符" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox Width="90" ItemsSource="{Binding L2LetterOptions}" SelectedItem="{Binding L2Letter, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                            <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,0,0,2">
                                                <Run Text="容量 "/><Run Text="{Binding L2SizeGB, Mode=OneWay, StringFormat=F0}"/><Run Text=" GB（1–128，缺省 32）"/>
                                            </TextBlock>
                                            <Slider Minimum="1" Maximum="128" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding L2SizeGB, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                            <TextBlock Text="{Binding L2SpaceHint, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="启用 L2" Command="{Binding EnableL2Command}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                                            <Button Content="关闭 L2" Command="{Binding DisableL2Command}" Style="{StaticResource BtnSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding L2CountersText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12"/>

                                    <Separator Margin="0,16,0,16" Background="{StaticResource RbcBorder}" Height="1"/>

                                    <!-- 顺序读预取（FR-PF-01 总开关 / FR-PF-03 温度护栏 / FR-PF-04 统计） -->
                                    <Grid>
                                        <TextBlock Text="顺序读预取" FontWeight="SemiBold" Foreground="{StaticResource RbcTextPrimary}" FontSize="13"/>
                                        <CheckBox Content="启用预取" IsChecked="{Binding PrefetchEnabled, Mode=TwoWay}"
                                                  HorizontalAlignment="Right" Foreground="{StaticResource RbcTextPrimary}"/>
                                    </Grid>
                                    <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"
                                               Text="顺序读时按窗口提前把后续数据读入缓存：顺序读的第二遍通常大幅提速（命中的是内存），随机读无益甚至略增开销。部署默认关闭，建议仅在 SSD 数据卷显式开启；每卷预读窗口在「加速」页卷卡上设置。"/>
                                    <TextBlock Text="{Binding PrefetchCountersText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12"/>
                                    <TextBlock Text="{Binding ThermalText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,4,0,0"/>

                                    <Separator Margin="0,16,0,16" Background="{StaticResource RbcBorder}" Height="1"/>

                                    <!-- 回写周期（BUG2：用户可配回写间隔；0=无限）-->
                                    <!-- [W1.5 D20] 行右内联 C-7 电源 chip（06 C-7.1 内联位转译落点：回写语境最贴近；
                                         有回写卷时常驻，与状态页/应急页/F3 对话框同 Key 同口径） -->
                                    <Grid>
                                        <TextBlock Text="回写周期" FontWeight="SemiBold" Foreground="{StaticResource RbcTextPrimary}" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FlushIntervalText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource RbcPowerStateChip}" DataContext="{Binding Features}" Margin="8,0,0,0"
                                                    Visibility="{Binding HasWritebackVolume, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource RbcPowerStateDot}"/>
                                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12">
                                                        <Run Text="{Binding PowerStateLabel, Mode=OneWay}"/><Run Text="{Binding PowerStatePct, Mode=OneWay}" FontFamily="{StaticResource RbcFontMono}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"
                                               Text="回写模式下，脏数据每隔该时间自动写入磁盘（写更快；掉电或异常退出可能丢失未落盘数据）。设为「无限」仅保留三种落盘时机：点击「立即回写」、卸载、关机。直写模式不产生脏数据，本项不生效。"/>
                                    <ComboBox Width="240" HorizontalAlignment="Left"
                                              SelectedIndex="{Binding FlushIntervalIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="10 秒"/>
                                        <ComboBoxItem Content="30 秒"/>
                                        <ComboBoxItem Content="60 秒（默认）"/>
                                        <ComboBoxItem Content="5 分钟"/>
                                        <ComboBoxItem Content="无限（关闭自动回写）"/>
                                    </ComboBox>

                                    <Separator Margin="0,16,0,16" Background="{StaticResource RbcBorder}" Height="1"/>

                                    <!-- [FIX B4] 内存预算（全局动态内存：驱动口径 10–95% / 0–65536MB 保留；
                                         写入走 GetConfig→SetConfig→回读校正，与回写周期同模式） -->
                                    <Grid>
                                        <TextBlock Text="内存预算" FontWeight="SemiBold" Foreground="{StaticResource RbcTextPrimary}" FontSize="13"/>
                                        <TextBlock Text="{Binding MemoryBudgetText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource RbcTextSecondary}" FontSize="12"/>
                                    </Grid>
                                    <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"
                                               Text="缓存预算 =（可用物理内存 − 保留量）× 自动占用百分比；保留量给系统和其他程序。"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="自动占用" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Slider Grid.Column="1" Minimum="10" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center" Value="{Binding AutoUsePct, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding AutoUsePctText, Mode=OneWay}" Foreground="{StaticResource RbcTextPrimary}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="44"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="系统保留" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="65536" TickFrequency="256" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center" Value="{Binding MemReserveMB, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding MemReserveText, Mode=OneWay}" Foreground="{StaticResource RbcTextPrimary}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="72"/>
                                    </Grid>

                                    <Separator Margin="0,16,0,16" Background="{StaticResource RbcBorder}" Height="1"/>

                                    <!-- [W1.5/R7] 冷读预期管理：第一遍读无加速的物理下限说明 -->
                                    <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" TextWrapping="Wrap"
                                               Text="为什么第一遍读没有加速？冷数据第一遍必须从盘读入，速度以物理盘为上限——这是物理下限，不是缺陷；第二遍起命中的是内存。"/>
                                </StackPanel>
                            </Border>

                            <!-- [M1/FR-BL-03] 进程准入排除产品化 -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="进程准入排除" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Text="命中名单的进程，其 I/O 不进缓存（直通）。碎片整理/备份/杀毒类工具运行期与缓存互相干扰，建议排除。支持 * ? 通配、大小写不敏感；最多 32 条、每条最多 15 字符。"/>
                                    <CheckBox Content="启用内置排除名单（defrag / dfrgui / wbengine / vssadmin / msmpeng）"
                                              IsChecked="{Binding UseDefaultExcl, Mode=TwoWay}"
                                              Foreground="{StaticResource RbcTextPrimary}" FontSize="13"/>
                                    <TextBlock Text="自定义名单（每行一个进程镜像名，保存后立即生效）" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" Margin="0,14,0,4"/>
                                    <TextBox Text="{Binding ExcludeText, Mode=TwoWay}" Height="96" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Background="{StaticResource RbcBgInput}" Foreground="{StaticResource RbcTextPrimary}"
                                             BorderBrush="{StaticResource RbcBorderDefault}" Padding="8" FontFamily="{StaticResource RbcFontMono}"/>
                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="{Binding AdmitRejectsText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Content="保存名单" Command="{Binding SaveExcludeCommand}" Style="{StaticResource BtnPrimary}"
                                                HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- [W1–W4] 预留功能与实验面（接口契约 + Noop 占位 + 错误路径可演示） -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="预留功能与实验" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                                               Text="迭代计划 W1–W4 波次的能力接口占位：契约、错误码与错误路径已就位并可演示；实现随对应波次交付。"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <CheckBox Content="匿名使用遥测（W1-1：默认关、匿名、一键可关）"
                                                      IsChecked="{Binding TelemetryOptIn, Mode=TwoWay}"
                                                      Foreground="{StaticResource RbcTextPrimary}" FontSize="13"/>
                                            <TextBlock Text="{Binding TelemetryStatusText, Mode=OneWay}" Foreground="{StaticResource RbcTextSecondary}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="减少动效（可访问性降级）" Foreground="{StaticResource RbcTextPrimary}" FontSize="13" Margin="0,0,0,6"/>
                                            <ComboBox Width="200" HorizontalAlignment="Left"
                                                      SelectedIndex="{Binding ReduceMotionIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="跟随系统设置（默认）"/>
                                                <ComboBoxItem Content="始终开启动效"/>
                                                <ComboBoxItem Content="减少动效"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <!-- 联调模式：接口预留角标总开关（前后端联调对齐"前端等什么后端"；默认关） -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <CheckBox Content="联调模式：显示接口预留角标（默认开）"
                                                      IsChecked="{Binding LinkMode, Mode=TwoWay}"
                                                      Foreground="{StaticResource RbcTextPrimary}" FontSize="13"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="角标语义：A=已接线（数据面就绪）· B=待驱动字段核对 · C=待接口（随消费方重建）· D=待实现。开后在界面上标注每个功能点的前后端对接状态；要干净产品视图可取消勾选。"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,4" CornerRadius="{StaticResource RbcRadiusSm}"
                                                Background="{StaticResource RbcBgInput}" BorderBrush="{StaticResource RbcBorderDefault}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:LinkChip Id="A6" Width="28" Height="16" Margin="0,0,4,0"/>
                                                <ctl:LinkChip Id="B2" Width="28" Height="16" Margin="0,0,4,0"/>
                                                <ctl:LinkChip Id="C5" Width="28" Height="16" Margin="0,0,4,0"/>
                                                <ctl:LinkChip Id="D1" Width="28" Height="16"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="许可状态与激活入口见上方「许可」卡。" Foreground="{StaticResource RbcTextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="重跑首次向导（W1-4）" Command="{Binding RerunWizardCommand}"
                                                Style="{StaticResource BtnSecondary}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卸载入口（D3：完整流程随 W1-2 交付） -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="卸载" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" TextWrapping="Wrap"
                                               Text="一键卸载入口随 W1-2 波次交付。届时将按顺序引导：停止全部卷加速并回写脏数据 → 停止并删除驱动服务 → 移除 UpperFilters（保留第三方过滤驱动）→ 提示重启。"/>
                                </StackPanel>
                            </Border>

                            <!-- ═══ V10.6 F5 许可卡（C-6：五态 + 大值槽三型 + 激活入口占位）═══
                                 [W1.5 D10/D15] 徽标 DataContext=Features（修复五态变色）；对齐 C-6.1 结构：
                                 卡头说明 13px / 「剩余」标签行 / 大值三型（32 mono / 17 文本型 / — secondary）/ 小字 -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="许可" FontSize="14" FontWeight="SemiBold"/>
                                        <!-- [B-14] 许可存储+LicenseStatus+激活端点移交后端；本地 30 天试用口径已冻结 -->
                                        <ctl:LinkChip Id="B-14" Width="28" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                      Visibility="{Binding DataContext.LinkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Border Style="{StaticResource RbcLicenseBadge}" DataContext="{Binding Features}" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource RbcNeutralFg}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LicenseState}" Value="expiring">
                                                                    <Setter Property="Fill" Value="{StaticResource RbcWarningFg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LicenseState}" Value="active">
                                                                    <Setter Property="Fill" Value="{StaticResource RbcSuccessFg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LicenseState}" Value="expired">
                                                                    <Setter Property="Fill" Value="{StaticResource RbcWarningFg}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Text="{Binding LicenseStateText, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 卡头说明（06 C-6.2 五态说明列） -->
                                        <TextBlock Text="{Binding DataContext.Features.LicenseHeadHint, ElementName=Win}" FontSize="13"
                                                   Foreground="{StaticResource RbcTextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <!-- 「剩余」标签行（试用/即将到期态；06 C-6.1） -->
                                    <TextBlock Text="剩余" FontSize="13" Foreground="{StaticResource RbcTextSecondary}" Margin="0,12,0,4"
                                               Visibility="{Binding DataContext.Features.LicenseDaysVisible, ElementName=Win, Converter={StaticResource BoolToVis}}"/>
                                    <!-- 大值槽三型 + 激活入口（按钮右对齐同行；占位框全程不禁用——红线 12 精神） -->
                                    <Grid Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DataContext.Features.LicenseBigText, ElementName=Win}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <!-- 数值型：32 mono/600；空值型「—」secondary（06 C-6.1 表） -->
                                                        <Setter Property="FontSize" Value="32"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="FontFamily" Value="{StaticResource RbcFontMono}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource RbcTextPrimary}"/>
                                                        <Style.Triggers>
                                                            <!-- 文本型（试用无上限「无限期」/已激活=许可类型）：17px/600 常规栈 -->
                                                            <DataTrigger Binding="{Binding DataContext.Features.LicenseState, ElementName=Win}" Value="active">
                                                                <Setter Property="FontSize" Value="17"/>
                                                                <Setter Property="FontFamily" Value="{StaticResource RbcFontUi}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.Features.LicenseState, ElementName=Win}" Value="trial">
                                                                <Setter Property="FontSize" Value="17"/>
                                                                <Setter Property="FontFamily" Value="{StaticResource RbcFontUi}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.Features.LicenseState, ElementName=Win}" Value="expired">
                                                                <Setter Property="Foreground" Value="{StaticResource RbcTextSecondary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text=" 天" FontSize="13" Foreground="{StaticResource RbcTextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,10"
                                                       Visibility="{Binding DataContext.Features.LicenseDaysVisible, ElementName=Win, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Button Content="输入许可密钥" Command="{Binding DataContext.Features.ActivateLicenseCommand, ElementName=Win}"
                                                Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- 卡底小字（06 C-6.2 小字列；非试用态为空自动隐藏） -->
                                    <TextBlock Text="{Binding DataContext.Features.LicenseFootText, ElementName=Win}" FontSize="12"
                                               Foreground="{StaticResource RbcTextSecondary}" Margin="0,12,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Features.LicenseFootText, ElementName=Win}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 关于 -->
                            <Border Background="{StaticResource RbcBgSurface}" BorderBrush="{StaticResource RbcBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RbcRadiusMd}" Padding="{StaticResource RbcPadCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Foreground="{StaticResource RbcTextSecondary}" FontSize="12" LineHeight="20">
                                        <!-- [P2-10] 版本串改为绑定（gen_version.ps1 → Version.cs 单一事实源），不再硬编码 -->
                                        <Run Text="RAMBlockCache " /><Run Text="{Binding ProductVersion, Mode=OneWay}" /><Run Text=" · Protocol 9" /><LineBreak/>
                                        <Run Text="4K 块缓存 · 读写全进内存 · 动态内存自适应（设置 0 = 用完全部剩余可用内存）" /><LineBreak/>
                                        <Run Text="热加载/热卸载免重启 · panic 熔断自动旁路 · 系统卷硬排除" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </DockPanel>

        <!-- [D5] Toast 命令反馈层（右下角叠加；出入场动画由代码侧 Motion 播放，
             遵守 reduced-motion 降级；每条 Toast 均来自真实命令完成事件） -->
        <ItemsControl x:Name="ToastHost" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,20,20" Panel.ZIndex="10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="toast" Padding="12,10" Margin="0,6,0,0" CornerRadius="{StaticResource RbcRadiusMd}"
                            BorderThickness="1" MaxWidth="360"
                            Background="{StaticResource RbcInfoBg}" BorderBrush="{StaticResource RbcInfoBorder}">
                        <TextBlock x:Name="tx" Text="{Binding Text, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource RbcInfoFg}"/>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static services:ToastLevel.Success}">
                            <Setter TargetName="toast" Property="Background" Value="{StaticResource RbcSuccessBg}"/>
                            <Setter TargetName="toast" Property="BorderBrush" Value="{StaticResource RbcSuccessBorder}"/>
                            <Setter TargetName="tx" Property="Foreground" Value="{StaticResource RbcSuccessFg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static services:ToastLevel.Warning}">
                            <Setter TargetName="toast" Property="Background" Value="{StaticResource RbcWarningBg}"/>
                            <Setter TargetName="toast" Property="BorderBrush" Value="{StaticResource RbcWarningBorder}"/>
                            <Setter TargetName="tx" Property="Foreground" Value="{StaticResource RbcWarningFg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static services:ToastLevel.Danger}">
                            <Setter TargetName="toast" Property="Background" Value="{StaticResource RbcDangerBg}"/>
                            <Setter TargetName="toast" Property="BorderBrush" Value="{StaticResource RbcDangerBorder}"/>
                            <Setter TargetName="tx" Property="Foreground" Value="{StaticResource RbcDangerFg}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══════════ V10.6 对话框层（06 RbcDialogHost 基座；C-4 回写引导 / C-5 反作弊警示） ═══════════ -->
        <ctl:DialogHost x:Name="DlgHost"/>

        <!-- C-4 回写开启引导对话框内容（480；onClose 统一收敛到取消语义——Esc/遮罩/取消按钮同口径）
             [W1.5 D12] 对齐 06 C-4.2 三段式结构：①将发生什么 / ②影响与风险（电源 chip + 场景适配 +
             当前卷）/ ③如何撤销；段间 1px 分隔线；确认按钮 BtnDanger（C-4.5 红线 5：危险动作用 danger 系） -->
        <Border x:Name="GuideDialogContent" Visibility="Collapsed" Width="480"
                Background="{StaticResource RbcBgElevated}" Padding="24,24,24,20">
            <StackPanel>
                <TextBlock Text="开启回写前，确认三件事" FontSize="17" FontWeight="SemiBold"/>
                <!-- ① 将发生什么 -->
                <TextBlock Text="将发生什么" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock Text="回写模式下，缓存先收下写请求再定时写入磁盘，写性能更好；但意外断电可能丢失尚未落盘的数据。"
                           FontSize="13" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap"/>
                <Separator Background="{StaticResource RbcBorder}" Height="1" Margin="0,16,0,0"/>
                <!-- ② 影响与风险 -->
                <TextBlock Text="影响与风险" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <!-- 电源态行（F3 输入；chip 20px 语义族；百分比等宽段） -->
                <Border Style="{StaticResource RbcPowerStateChip}" DataContext="{Binding Features}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource RbcPowerStateDot}"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12">
                            <Run Text="{Binding PowerStateLabel, Mode=OneWay}"/><Run Text="{Binding PowerStatePct, Mode=OneWay}" FontFamily="{StaticResource RbcFontMono}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- 态说明行（缩进对齐 chip + 8px；06 C-4.3） -->
                <TextBlock Text="{Binding DataContext.Features.GuidePowerHint, ElementName=Win}" FontSize="13" Foreground="{StaticResource RbcTextSecondary}"
                           Margin="8,4,0,0" TextWrapping="Wrap"/>
                <!-- 场景适配双列清单（推荐=info 底 / 劝阻=warning 底） -->
                <TextBlock Text="哪些目录适合回写" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource RbcAdviceInfo}" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="推荐开启" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RbcInfoFg}" Margin="0,0,0,4"/>
                            <TextBlock Text="· 下载目录" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,1,0,0"/>
                            <TextBlock Text="· 编译输出目录" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,1,0,0"/>
                            <TextBlock Text="· 临时文件目录" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource RbcAdviceWarn}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="不建议开启" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RbcWarningFg}" Margin="0,0,0,4"/>
                            <TextBlock Text="· 数据库文件" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,1,0,0"/>
                            <TextBlock Text="· 备份镜像目录" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,1,0,0"/>
                            <TextBlock Text="· 虚拟机磁盘文件" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 当前卷行（06 C-4.3：标签 secondary + 盘符/卷名 mono primary） -->
                <TextBlock FontSize="12" Margin="0,12,0,0">
                    <Run Text="当前卷：" Foreground="{StaticResource RbcTextSecondary}"/>
                    <Run Text="{Binding DataContext.Features.GuideVolumesText, ElementName=Win, Mode=OneWay}"
                         FontFamily="{StaticResource RbcFontMono}" Foreground="{StaticResource RbcTextPrimary}"/>
                </TextBlock>
                <Separator Background="{StaticResource RbcBorder}" Height="1" Margin="0,16,0,0"/>
                <!-- ③ 如何撤销 -->
                <TextBlock Text="如何撤销" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock Text="随时切回直写；卸载或关机会自动回写脏数据。"
                           FontSize="13" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap"/>
                <Separator Background="{StaticResource RbcBorder}" Height="1" Margin="0,16,0,0"/>
                <!-- 风险句（06 C-4.3：13px warning + 勾选上方上下留 12px） -->
                <TextBlock Text="回写模式下，未落盘数据在掉电时可能丢失。" FontSize="13" Foreground="{StaticResource RbcWarningFg}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <CheckBox Margin="0,8,0,0" IsChecked="{Binding DataContext.Features.GuideAck, ElementName=Win}" Foreground="{StaticResource RbcTextPrimary}" FontSize="13"
                          Content="我已知悉上述风险"/>
                <!-- 禁用原因行（[审查 P1] 红线 12：未勾选/低电量必给原因；06 C-4.3 规格 12px secondary） -->
                <TextBlock Text="{Binding DataContext.Features.GuideBlockReason, ElementName=Win}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                <!-- 按钮行（取消 BtnSecondary + 开启回写 BtnDanger——C-4.5；打开时焦点落取消；danger 不做默认焦点） -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="取消" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"
                            Click="GuideCancel_Click" x:Name="GuideCancelBtn"/>
                    <Button Grid.Column="2" Content="开启回写" Style="{StaticResource BtnDanger}"
                            Click="GuideConfirm_Click" IsEnabled="{Binding DataContext.Features.GuideAck, ElementName=Win}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- C-5 反作弊警示对话框内容（440 .dialog-sm；三段式 + 不再提示 + 次按钮 R-3）
             [W1.5 D13] 对齐 06 C-5.1/C-5.6：标题/段标题 13-600/规范文案三段 + 段间分隔线 +
             签名态未知保守分支句 + 勾选说明行 + 勾选与按钮同行（勾左/按钮右） -->
        <Border x:Name="AnticheatDialogContent" Visibility="Collapsed" Width="440"
                Background="{StaticResource RbcBgElevated}" Padding="24,24,24,20">
            <StackPanel>
                <TextBlock Text="反作弊环境提醒" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="发生了什么" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock Text="{Binding DataContext.Features.AnticheatServicesText, ElementName=Win}" FontSize="13" Foreground="{StaticResource RbcTextSecondary}"
                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="正在运行；当前 RAMBlockCache 驱动为测试签名版。" FontSize="13" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <!-- 保守分支（06 C-5.1：签名态取不到时追加，13px secondary） -->
                <TextBlock Text="驱动签名状态未知，按测试签名版处理。" FontSize="13" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.Features.DriverSignatureKnown, ElementName=Win}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Separator Background="{StaticResource RbcBorder}" Height="1" Margin="0,16,0,0"/>
                <TextBlock Text="影响与风险" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock Text="部分反作弊系统可能拦截测试签名版驱动，可能导致相关游戏无法启动，或驱动被强制卸载。正式签名版不受影响。"
                           FontSize="13" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <Separator Background="{StaticResource RbcBorder}" Height="1" Margin="0,16,0,0"/>
                <TextBlock Text="怎么办" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock Text="安装正式签名（EV）版驱动后重启本程序。" FontSize="13" Foreground="{StaticResource RbcTextSecondary}"
                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                <!-- 勾选与按钮同行（06 C-5.1 结构图：勾选左 + 单按钮右） -->
                <Grid Margin="0,16,0,0">
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding AnticheatMute, ElementName=Win}" Foreground="{StaticResource RbcTextPrimary}" FontSize="12"
                              Content="不再提示"/>
                    <Button Content="了解 EV 版" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right" Click="AnticheatAck_Click"/>
                </Grid>
                <TextBlock Text="勾选后，后续启动不再显示本对话框；检测结果仍可在诊断页查看。"
                           FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <!-- C-6 许可激活占位对话框内容（360；06 C-6.3：标题「激活通道」+ 正文 + 单按钮[知道了]）
             [W1.5 D14] 替换原系统 MessageBox——弹窗级规范（RbcDialogHost 基座）统一品牌浮层 -->
        <Border x:Name="LicensePlaceholderContent" Visibility="Collapsed" Width="360"
                Background="{StaticResource RbcBgElevated}" Padding="24,24,24,20">
            <StackPanel>
                <TextBlock Text="激活通道" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="激活向导随正式版发布提供；试用期内可在安装器中输入许可密钥。"
                           FontSize="13" Foreground="{StaticResource RbcTextSecondary}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <Button Content="知道了" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right" Margin="0,20,0,0"
                        Click="LicensePlaceholderAck_Click"/>
            </StackPanel>
        </Border>
        <!-- B-10 系统卷 opt-in 三段式确认框内容（480；Esc/遮罩=取消，零副作用） -->
        <Border x:Name="SysVolOptInContent" Visibility="Collapsed" Width="480"
                Background="{StaticResource RbcBgElevated}" Padding="24">
            <StackPanel>
                <TextBlock Text="开启系统卷加速前，确认三件事" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="将发生什么" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RbcTextSecondary}" Margin="0,16,0,0"/>
                <TextBlock Text="系统盘（C:）的读请求将改由缓存满足，命中部分不再读磁盘。" FontSize="12" Foreground="{StaticResource RbcTextPrimary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="影响与风险" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RbcTextSecondary}" Margin="0,12,0,0"/>
                <TextBlock Text="系统卷强制直写（永不回写）：写入仍直接落盘，掉电不会丢失未落盘数据；占用一部分内存配额。" FontSize="12" Foreground="{StaticResource RbcTextPrimary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="如何恢复" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RbcTextSecondary}" Margin="0,12,0,0"/>
                <TextBlock Text="再次点击「关闭」或恢复默认预设即可取消；确认记录可在诊断包中查看。" FontSize="12" Foreground="{StaticResource RbcTextPrimary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="取消" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"
                            Click="SysVolOptInCancel_Click" x:Name="SysVolOptInCancelBtn"/>
                    <Button Grid.Column="2" Content="确认开启" Style="{StaticResource BtnPrimary}" Click="SysVolOptInConfirm_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
