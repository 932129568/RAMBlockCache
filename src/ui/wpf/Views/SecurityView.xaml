<UserControl x:Class="RamBoostFS.Wpf.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RamBoostFS.Wpf.Controls"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="600" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 安全模式横幅 -->
        <Border x:Name="safeBanner" Grid.Row="0" Background="#33E81123" CornerRadius="10" Padding="18,14"
                Margin="0,0,0,14" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <StackPanel>
                    <TextBlock Text="⚠ 安全模式" Style="{StaticResource SubtitleText}" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="上次异常退出（蓝屏/断电/强杀）。写缓存已关闭，当前为直写(write-through)。确认磁盘数据无误后，点击右侧按钮恢复写缓存。"
                               Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button x:Name="exitSafeBtn" Content="一键恢复 (EXIT_SAFE_MODE)" Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="ExitSafe_Click"/>
            </Grid>
        </Border>

        <!-- 丢失脏数据告警 -->
        <Border x:Name="lostDirtyBanner" Grid.Row="0" Background="#33E81123" CornerRadius="10" Padding="18,14"
                Margin="0,0,0,14" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="lostDirtyTitle" Text="⚠ 磁盘故障导致脏数据丢失" Style="{StaticResource SubtitleText}" Foreground="{StaticResource DangerBrush}"/>
                <TextBlock x:Name="lostDirtyText" Text="LostDirtyBytes = 0" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- 紧急动作 -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="立即回写" Style="{StaticResource SubtitleText}"/>
                    <TextBlock Text="把所有脏数据立刻刷到磁盘 (FLUSH)，降低断电风险。" Style="{StaticResource CaptionText}" Margin="0,6,0,12"/>
                    <Button Content="立即回写 (FLUSH)" Style="{StaticResource AccentButton}" Click="Flush_Click"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                <StackPanel>
                    <TextBlock Text="游戏模式" Style="{StaticResource SubtitleText}"/>
                    <TextBlock Text="切换 testsigning 以兼容反作弊；需重启生效。" Style="{StaticResource CaptionText}" Margin="0,6,0,12"/>
                    <Button x:Name="gameBtn" Content="进入游戏模式" Style="{StaticResource PillButton}" Click="Game_Click"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="预读有效性" Style="{StaticResource SubtitleText}"/>
                    <TextBlock x:Name="readaheadPctText" Text="N/A" Style="{StaticResource MetricValueText}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="readaheadSub" Text="V7 未启用" Style="{StaticResource CaptionText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 行为开关 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="缓存行为" Style="{StaticResource SubtitleText}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12" IsEnabled="False" Opacity="0.55">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="顺序预读 (Readahead)" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="块层下由驱动自管预读窗口，开关保留暂不开放。" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <controls:RbToggleSwitch x:Name="readaheadToggle" HorizontalAlignment="Right" Toggled="Readahead_Toggled"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="冻结缓存 (Frozen)" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="停止填充新数据，已有缓存仍服务命中。" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <controls:RbToggleSwitch x:Name="frozenToggle" HorizontalAlignment="Right" Toggled="Frozen_Toggled"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="写后释放 (WriteRelease)" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="回写完成后释放缓存槽，把空间留给读缓存；写重负载时开启。" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <controls:RbToggleSwitch x:Name="writeReleaseToggle" HorizontalAlignment="Right" Toggled="WriteRelease_Toggled"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="空闲/待机回写 (IdleFlush)" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="系统空闲时主动回写脏数据，降低睡眠/断电风险。" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <controls:RbToggleSwitch x:Name="idleFlushToggle" HorizontalAlignment="Right" Toggled="IdleFlush_Toggled"/>
                </Grid>

                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="空闲自动释放 (IdleReclaim)" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="超过阈值未访问的块自动释放（默认 1800 秒）。" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <controls:RbToggleSwitch x:Name="idleReclaimToggle" HorizontalAlignment="Right" Toggled="IdleReclaim_Toggled"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="高级参数" Style="{StaticResource SubtitleText}" Margin="0,0,0,12"/>
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="脏高水位 %" Style="{StaticResource CaptionText}"/>
                        <TextBox x:Name="highBox" Text="60" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="脏低水位 %" Style="{StaticResource CaptionText}"/>
                        <TextBox x:Name="lowBox" Text="40" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="回写周期 ms" Style="{StaticResource CaptionText}"/>
                        <TextBox x:Name="flushBox" Text="10000" Margin="0,6,0,0"/>
                    </StackPanel>
                </UniformGrid>
                <Button Content="应用高级参数" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Advanced_Click"/>
                <TextBlock x:Name="advResult" Text="" Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
