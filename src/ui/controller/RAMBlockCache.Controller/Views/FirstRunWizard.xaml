<Window x:Class="RAMBlockCache.Controller.Views.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 RAMBlockCache" Height="520" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource RbcBgApp}" Foreground="{StaticResource RbcTextPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 步骤指示（五步：认识 → 环境自检 → 选卷 → 选预设 → 完成；V10.6 F1 第三入口） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,20,28,0">
            <TextBlock Text="① 认识" FontSize="12" Foreground="{StaticResource RbcAccent}"/>
            <TextBlock Text="  →  " FontSize="12" Foreground="{StaticResource RbcTextTertiary}"/>
            <TextBlock Text="② 环境自检" FontSize="12" Foreground="{StaticResource RbcAccent}"/>
            <TextBlock Text="  →  " FontSize="12" Foreground="{StaticResource RbcTextTertiary}"/>
            <TextBlock Text="③ 选卷" FontSize="12" Foreground="{StaticResource RbcAccent}"/>
            <TextBlock Text="  →  " FontSize="12" Foreground="{StaticResource RbcTextTertiary}"/>
            <TextBlock Text="④ 选预设" FontSize="12" Foreground="{StaticResource RbcAccent}"/>
            <TextBlock Text="  →  " FontSize="12" Foreground="{StaticResource RbcTextTertiary}"/>
            <TextBlock Text="⑤ 完成" FontSize="12" Foreground="{StaticResource RbcAccent}"/>
        </StackPanel>

        <!-- 步骤 1：认知 + 适用/不适用（U0-4 预期管理） -->
        <StackPanel Grid.Row="1" Margin="28,16,28,0" Visibility="{Binding ShowStep1, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="RAMBlockCache 用内存给你的数据盘加速" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource RbcTextSecondary}"
                       Text="系统盘默认不加速（安全第一）；数据盘的选择权在你。三步之后就能看到效果。"/>
            <Border Margin="0,16,0,0" Padding="14" CornerRadius="6" Background="{StaticResource RbcBgSurface}">
                <StackPanel>
                    <TextBlock Text="适用 / 不适用" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RbcWarningFg}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource RbcTextSecondary}"
                               Text="适用：数据盘的随机读写、游戏/软件二次加载、大文件顺序读——通常明显更快。&#x0a;不适用：NVMe 系统盘收益有限（盘本身已快）；持续大写场景建议保持直写。"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 步骤 2：环境自检（D6/UX J1：驱动连接/协议/卷枚举/管理员身份实测） -->
        <StackPanel Grid.Row="1" Margin="28,16,28,0" Visibility="{Binding ShowStep2, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="先检查一下环境" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource RbcTextSecondary}"
                       Text="四项实测，任一不过也能继续——驱动恢复或提权后同样可用。"/>
            <Border Margin="0,14,0,0" CornerRadius="6" Background="{StaticResource RbcBgSurface}" Padding="12">
                <ItemsControl ItemsSource="{Binding EnvChecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="mark" Grid.Column="0" Width="20" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource RbcSuccessFg}" Text="✓"/>
                                <TextBlock Grid.Column="0" Margin="24,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Text="{Binding Name}"/>
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" TextWrapping="Wrap"
                                           Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Detail}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                    <Setter TargetName="mark" Property="Foreground" Value="{StaticResource RbcDangerFg}"/>
                                    <Setter TargetName="mark" Property="Text" Value="✕"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource RbcTextPrimary}"
                       Text="{Binding EnvSummary, Mode=OneWay}"/>
        </StackPanel>

        <!-- 步骤 3：卷选择 -->
        <Grid Grid.Row="1" Margin="28,16,28,0" Visibility="{Binding ShowStep3, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource RbcTextSecondary}"
                       Text="选择要加速的数据卷（默认已勾选；系统盘默认不加速，可在磁盘页手动开启）。"/>
            <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="6" Background="{StaticResource RbcBgSurface}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Volumes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="6" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding CanSelect}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DriveLetter, Mode=OneWay}" FontWeight="SemiBold" Width="34"/>
                                        <TextBlock Text="{Binding Label, Mode=OneWay}" Width="120" Foreground="{StaticResource RbcTextSecondary}"/>
                                        <TextBlock Text="{Binding CapacityText, Mode=OneWay}" Foreground="{StaticResource RbcTextTertiary}"/>
                                        <TextBlock Text="  系统卷" Foreground="{StaticResource RbcWarningFg}"
                                                   Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <CheckBox Grid.Row="2" Margin="0,10,0,0" Content="以后开机自动挂载这些卷"
                      IsChecked="{Binding AutoMountAfterBoot, Mode=TwoWay}"/>
        </Grid>

        <!-- 步骤 4：场景预设选择（V10.6 F1 第三入口；三档卡片单选，零术语） -->
        <StackPanel Grid.Row="1" Margin="28,16,28,0" Visibility="{Binding ShowStep4, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource RbcTextSecondary}"
                       Text="选一个档位，常用参数自动填好。之后可随时在设置页更改。"/>
            <ListBox ItemsSource="{Binding PresetOptions}" Margin="0,12,0,0"
                     SelectedValuePath="Key" SelectedValue="{Binding WizardPresetKey, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,12" CornerRadius="6" Cursor="Hand"
                                Background="{StaticResource RbcBgSurface}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource RbcBorder}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource RbcAccent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,12,0" VerticalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource RbcNeutralFg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Key}" Value="safe">
                                                    <Setter Property="Background" Value="{StaticResource RbcInfoFg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="balanced">
                                                    <Setter Property="Background" Value="{StaticResource RbcAccent}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="perf">
                                                    <Setter Property="Background" Value="{StaticResource RbcWarningFg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Desc}" FontSize="12" Foreground="{StaticResource RbcTextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- 步骤 5：完成 + 效果验证 -->
        <StackPanel Grid.Row="1" Margin="28,16,28,0" Visibility="{Binding ShowStep5, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SummaryText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
            <Border Margin="0,14,0,0" Padding="14" CornerRadius="6" Background="{StaticResource RbcSuccessBg}">
                <TextBlock Text="{Binding EffectText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource RbcSuccessFg}"/>
            </Border>
            <TextBlock Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource RbcTextTertiary}"
                       Text="提示：默认写模式为直写（写同时落盘，最安全）。回写是写加速的唯一入口（写入标脏即返回、后台落盘），但掉电或异常退出可能丢失尚未落盘的数据；需要写加速时可在卷卡片上对数据卷显式开启。"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <Grid Grid.Row="2" Margin="28,14,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource RbcTextTertiary}"
                       Text="可随时在设置页重跑本向导"/>
            <!-- [FIX C#6] 跳过向导：显式表达"现在不配"（原只能关 X，且下次再弹） -->
            <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="跳过向导" Margin="0,0,8,0"
                    Command="{Binding SkipCommand}"/>
            <Button Grid.Column="2" Style="{StaticResource BtnSecondary}" Content="上一步" Margin="0,0,8,0"
                    Command="{Binding BackCommand}"/>
            <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="{Binding NextText, Mode=OneWay}"
                    Command="{Binding NextCommand}"/>
        </Grid>
    </Grid>
</Window>
