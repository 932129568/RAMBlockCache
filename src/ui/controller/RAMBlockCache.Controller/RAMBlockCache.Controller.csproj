<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- [P0-3 2026-10-31] .NET 8 EOL 2026-11-10，升级至 net10.0-windows（SDK ≥10.0.14）；
         版本资源保持 10.4.1.19（机器版本串，check_repo 版本五联动口径）不变。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RAMBlockCache.Controller</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- [P3] 版本统一为机器版本串（common/version.h 的 10.4.0.19）；
         旧值 10.4.3（发布名）与旧 WPF csproj 的 10.3.4.19 互相矛盾。 -->
    <Version>10.4.1.19</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- [UI-HOST 2026-11-05] WebView2 壳：控制器内嵌 Web 控制台（UI 与 Web 端永远一致）。
         Win11 自带 Evergreen Runtime；Win10 由 Evergreen 引导自动安装。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>
</Project>
