<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:sys="clr-namespace:System;assembly=mscorlib"
                   xmlns:ctl="clr-namespace:RAMBlockCache.Controller.Controls">
    <!-- =====================================================================
         RAMBlockCache 设计令牌 V2.0（来源：deliverables/design/
         02-design-system.md + 02b-charts-motion.md + 04b-design-tokens-2026-10-19.md
         裁定：8 处漂移以 02 规范为准销号；新增令牌全部带消费方（零死令牌纪律）。
         旧令牌 BgBrush/CardBrush/FgBrush/DimBrush/AccentBrush 保留为别名
         （存量 XAML 绑定不破坏；五枚别名值与令牌等值，无漂移）。
         动效时长/缓动单一事实源在 Controls/Motion.cs（含 Dur320 专用档 +
         EaseInOut 第 5 条曲线，02b §B.1 v1.2/v1.3 增补）。
         ===================================================================== -->

    <!-- ===== 背景层级（02 §B.1.1）===== -->
    <SolidColorBrush x:Key="RbcBgApp"          Color="#FF0E0E11"/>
    <SolidColorBrush x:Key="RbcBgSidebar"      Color="#FF121216"/>
    <SolidColorBrush x:Key="RbcBgStatusbar"    Color="#FF14141A"/>
    <SolidColorBrush x:Key="RbcBgSurface"      Color="#FF17171C"/>
    <SolidColorBrush x:Key="RbcBgSurfaceHover" Color="#FF1E1E24"/>
    <SolidColorBrush x:Key="RbcBgElevated"     Color="#FF22222A"/>
    <SolidColorBrush x:Key="RbcBgInput"        Color="#FF1B1B21"/>
    <!-- [FIX B26] 死令牌 RbcBgSkeleton 已删除（零消费方；如需请随消费方一并加回） -->

    <!-- ===== 描边（02 §B.1.1；RbcBorder ≡ border-subtle）===== -->
    <SolidColorBrush x:Key="RbcBorder"         Color="#FF23232B"/>
    <SolidColorBrush x:Key="RbcBorderDefault"  Color="#FF2C2C35"/>
    <SolidColorBrush x:Key="RbcBorderStrong"   Color="#FF3A3A45"/>

    <!-- ===== 文字层级（02 §B.1.2；tertiary 仅限 ≥24px 或非信息装饰，见 04b §F-1）===== -->
    <SolidColorBrush x:Key="RbcTextPrimary"    Color="#FFEDEDF2"/>
    <SolidColorBrush x:Key="RbcTextSecondary"  Color="#FF9A9AA5"/>
    <SolidColorBrush x:Key="RbcTextTertiary"   Color="#FF6B6B76"/>
    <SolidColorBrush x:Key="RbcTextDisabled"   Color="#FF4A4A54"/>
    <SolidColorBrush x:Key="RbcTextOnAccent"   Color="#FF06222E"/>

    <!-- ===== 强调 / 交互身份（02 §B.1.3；禁止表达状态）===== -->
    <SolidColorBrush x:Key="RbcAccent"         Color="#FF4CC2FF"/>
    <SolidColorBrush x:Key="RbcAccentHover"    Color="#FF6FD0FF"/>
    <SolidColorBrush x:Key="RbcAccentActive"   Color="#FF2AA8E8"/>
    <SolidColorBrush x:Key="RbcAccentSubtle"   Color="#FF0A2636"/>
    <SolidColorBrush x:Key="RbcFocusRing"      Color="#8C4CC2FF"/>   <!-- α.55，实测 min 3.35:1（R-7） -->

    <!-- ===== 语义五色（02 §B.1.4 · 三件套 + 实心；对比度实测见 04b §2.4）===== -->
    <SolidColorBrush x:Key="RbcSuccessFg"      Color="#FF63D6A0"/>
    <SolidColorBrush x:Key="RbcSuccessBg"      Color="#FF0E2A20"/>
    <SolidColorBrush x:Key="RbcSuccessBorder"  Color="#FF1E5C46"/>
    <SolidColorBrush x:Key="RbcSuccessSolid"   Color="#FF1F8F63"/>   <!-- 仅图形；禁白字（F-3） -->
    <SolidColorBrush x:Key="RbcWarningFg"      Color="#FFF2B84B"/>
    <SolidColorBrush x:Key="RbcWarningBg"      Color="#FF2E2109"/>
    <SolidColorBrush x:Key="RbcWarningBorder"  Color="#FF7A5310"/>
    <SolidColorBrush x:Key="RbcDangerFg"       Color="#FFF27A72"/>
    <SolidColorBrush x:Key="RbcDangerBg"       Color="#FF331312"/>
    <SolidColorBrush x:Key="RbcDangerBorder"   Color="#FF8A2A26"/>
    <SolidColorBrush x:Key="RbcDangerSolid"    Color="#FFB3382F"/>   <!-- 原 RbcDangerBtn（A-2） -->
    <SolidColorBrush x:Key="RbcDangerSolidHover" Color="#FFC6453B"/> <!-- 原 RbcDangerBtnHover（A-2） -->
    <SolidColorBrush x:Key="RbcInfoFg"         Color="#FF6FB4F5"/>
    <SolidColorBrush x:Key="RbcInfoBg"         Color="#FF0C2138"/>
    <SolidColorBrush x:Key="RbcInfoBorder"     Color="#FF1E4E80"/>
    <SolidColorBrush x:Key="RbcNeutralFg"      Color="#FFA6A6B0"/>
    <SolidColorBrush x:Key="RbcNeutralBg"      Color="#FF1C1C22"/>
    <SolidColorBrush x:Key="RbcNeutralBorder"  Color="#FF3A3A45"/>
    <!-- 缓引（无消费方，随消费方同波加回，零死令牌纪律）：
         RbcWarningSolid #B07C18 / RbcInfoSolid #2E6DB4（02 §B.1.4 保留定义） -->

    <!-- ===== 进度轨道 ===== -->
    <SolidColorBrush x:Key="RbcTrackBg"        Color="#FF23232B"/>

    <!-- ===== 图表专用色（02b §A.2 · 随 T2.4 消费方同波落地，I7）=====
         数据系（青蓝）只表达"量"；语义系直引 Rbc*Fg（ok/warn/danger/neutral 不设独立键）；
         禁第三色系；禁语义色画中性趋势、禁青蓝画状态点。 -->
    <SolidColorBrush x:Key="RbcChart1"         Color="#FF4CC2FF"/>
    <SolidColorBrush x:Key="RbcChart2"         Color="#FF2E86D6"/>
    <SolidColorBrush x:Key="RbcChartGrid"      Color="#FF23232B"/>
    <SolidColorBrush x:Key="RbcChartAxisText"  Color="#FF9A9AA5"/>   <!-- R-2：11px 信息文本须 AA -->
    <SolidColorBrush x:Key="RbcChartAreaFill"  Color="#1F4CC2FF"/>   <!-- α12% 单色面积填充 -->
    <SolidColorBrush x:Key="RbcChartTrack"     Color="#FF23232B"/>
    <SolidColorBrush x:Key="RbcChartHeat1"     Color="#FF1E3A4D"/>
    <SolidColorBrush x:Key="RbcChartHeat2"     Color="#FF2E86D6"/>
    <SolidColorBrush x:Key="RbcChartHeat3"     Color="#FF4CC2FF"/>
    <!-- [FIX B26] 死令牌 RbcSkeletonHighlight 已删除（零消费方；如需请随消费方一并加回） -->

    <!-- ===== 字体（02 §B.2.1）===== -->
    <FontFamily x:Key="RbcFontUi">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="RbcFontMono">Cascadia Mono, Consolas</FontFamily>

    <!-- ===== 间距 / 圆角 / 布局常量（02 §B.3；space-1..7 为规范令牌，此处列高频资源）===== -->
    <Thickness x:Key="RbcPadCard">16,16</Thickness>
    <Thickness x:Key="RbcPadBtn">12,8</Thickness>
    <!-- [FIX B26] 死令牌 RbcPadSeg 已删除（零消费方；如需请随消费方一并加回） -->
    <Thickness x:Key="RbcPadStatusbar">12,0</Thickness>
    <CornerRadius x:Key="RbcRadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RbcRadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RbcRadiusMd">10</CornerRadius>
    <!-- [FIX B26 纪律兑现] RbcRadiusLg 曾当死令牌删除；V10.6 DialogHost 弹层面板成为真实消费方，随消费方加回（06 令牌五档 lg=12） -->
    <CornerRadius x:Key="RbcRadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RbcRadiusPill">999</CornerRadius>
    <sys:Double x:Key="RbcSidebarWidth">216</sys:Double>
    <sys:Double x:Key="RbcStatusbarHeight">40</sys:Double>
    <!-- [FIX B26] 死令牌 RbcContentPad 已删除（零消费方；如需请随消费方一并加回） -->
    <!-- [FIX B26] 死令牌 RbcGridGap 已删除（零消费方；如需请随消费方一并加回） -->

    <!-- ===== 存量别名（兼容旧 XAML，勿在新代码中使用；值与令牌等值）===== -->
    <SolidColorBrush x:Key="BgBrush"     Color="#FF0E0E11"/>
    <SolidColorBrush x:Key="CardBrush"   Color="#FF17171C"/>
    <SolidColorBrush x:Key="FgBrush"     Color="#FFEDEDF2"/>
    <SolidColorBrush x:Key="DimBrush"    Color="#FF9A9AA5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF"/>

    <!-- ===== 焦点环（02b §B.3-11：2px 外环，键盘焦点始终可见；I2 无淡入）===== -->
    <Style x:Key="RbcFocusRingStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{StaticResource RbcFocusRing}" StrokeThickness="2"
                               RadiusX="4" RadiusY="4" SnapsToDevicePixels="True" Margin="-2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 按钮：主 / 次 / 危险 / 幽灵（02 §B.4.1 + 04b §8.2）===== -->
    <!-- 主按钮 = 青色身份（04b §11.1 主理人拍板：对齐 02 规范 #4CC2FF）；
         危险按钮 Focusable=False（契约：不做默认焦点）。 -->
    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource RbcTextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="{StaticResource RbcPadBtn}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RbcFocusRingStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RbcRadiusSm}" Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="press" Y="0"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <!-- 02b 允许特效：按钮按下位移 1px（只动 transform）。
                                 Trigger Setter 无法定向属性元素内的命名 transform（MC4111），
                                 改走 EnterActions/ExitActions + Storyboard.TargetName 动画；
                                 释放在 IsPressed=False 的 ExitActions 回位（非弹跳）。 -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="Y"
                                                         To="1" Duration="{x:Static ctl:Motion.Dur90}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="{x:Static ctl:Motion.Dur90}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- 04b §8.2：禁用态 = 输入底 + 禁用文字色（原因文案由卡外副文本承载） -->
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RbcBgInput}"/>
                            <Setter Property="Foreground" Value="{StaticResource RbcTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource RbcAccent}"/>
        <Setter Property="Foreground" Value="{StaticResource RbcTextOnAccent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RbcAccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource RbcAccentActive}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource RbcBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RbcBgSurfaceHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource RbcDangerSolid}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Focusable" Value="False"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RbcDangerSolidHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FF9E2F27"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource RbcTextSecondary}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="28"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RbcBgInput}"/>
                <Setter Property="Foreground" Value="{StaticResource RbcTextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 幽灵派生（ToggleButton 专用：收益页二级明细折叠开关）。
         注意：ToggleButton 不继承 Button，不能 BasedOn BtnBase/BtnGhost，须独立定义。 -->
    <Style x:Key="BtnGhostToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource RbcTextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RbcFocusRingStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource RbcRadiusSm}"
                            BorderBrush="{StaticResource RbcBorderDefault}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RbcBgInput}"/>
                            <Setter Property="Foreground" Value="{StaticResource RbcTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RbcAccentSubtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource RbcTextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 加速开关（ToggleButton 药丸：轨道 + 滑块；勾选=青色=已挂载加速；原型 ctl-col 主控件） -->
    <Style x:Key="SwitchToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RbcFocusRingStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="40" Height="22">
                        <Border x:Name="track" Background="{StaticResource RbcBgInput}" BorderBrush="{StaticResource RbcBorderDefault}"
                                BorderThickness="1" CornerRadius="11"/>
                        <Ellipse x:Name="knob" Width="14" Height="14" Fill="{StaticResource RbcTextSecondary}"
                                 HorizontalAlignment="Left" Margin="5,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- §2.8：开 = RbcSuccessSolid（仅图形用途 F-3）+ knob #FFF -->
                            <Setter TargetName="track" Property="Background" Value="{StaticResource RbcSuccessSolid}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource RbcSuccessSolid}"/>
                            <Setter TargetName="knob" Property="Fill" Value="White"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,5,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource RbcBorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ===== Expander（暗色模板：收益页二级明细；标题行 + Chevron 旋转 180ms，§1/§5 明文） ===== -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource RbcTextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Cursor="Hand"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                              VerticalAlignment="Center"/>
                                            <Path x:Name="chev" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource RbcTextSecondary}"
                                                  RenderTransformOrigin="0.5,0.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Path.RenderTransform>
                                                    <RotateTransform/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="BodySite" Visibility="Collapsed" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="BodySite" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="chev"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="180" Duration="{x:Static ctl:Motion.Dur180}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="chev"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="0" Duration="{x:Static ctl:Motion.Dur180}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- =====================================================================
         V10.6 增量（06-v106-design-tokens-2026-10-21.md：C-1~C-7 组件 +
         N-1/N-2/N-3 令牌）。纪律：V2 令牌全冻结不动；本区只新增。
         N-1 DurStagger / N-2 ScaleOverlayFrom 落在 Controls/Motion.cs；
         此处补 N-3 度量令牌 + 新组件样式。状态色一律 DataTrigger 绑 VM 字符串键。
         ===================================================================== -->

    <!-- N-3 预设档位语义条宽度（度量常量；间距体系之外，不与 4 的倍数栅格混淆） -->
    <sys:Double x:Key="RbcPresetTierBarWidth">3</sys:Double>

    <!-- C-1 场景预设卡（设置页置顶功能卡） -->
    <Style x:Key="RbcPresetCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RbcBgSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RbcBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RbcRadiusMd}"/>
        <Setter Property="Padding" Value="16,16,16,16"/>
    </Style>

    <!-- C-1 三档语义条（3px 左条；06 R-1 裁定：档位标识≠状态表达，安全=info/均衡=accent/性能=warning/自定义=neutral）
         [W1.5 D10] 样式与 DataContext 约定：消费位 Border 须设 DataContext=FeaturesViewModel（PresetTier 在其上） -->
    <Style x:Key="RbcPresetTierBar" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource RbcPresetTierBarWidth}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{StaticResource RbcNeutralFg}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PresetTier}" Value="safe">
                <Setter Property="Background" Value="{StaticResource RbcInfoFg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PresetTier}" Value="balanced">
                <Setter Property="Background" Value="{StaticResource RbcAccent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PresetTier}" Value="perf">
                <Setter Property="Background" Value="{StaticResource RbcWarningFg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- C-2 预设来源 chip（16px 轻量角标族：surface 底 + 1px 描边 + 常规中文；与灰底等宽字母的 LinkChip 五重区分） -->
    <Style x:Key="RbcSourceChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RbcBgSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RbcBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RbcRadiusPill}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RbcBgSurfaceHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- C-7 电源 chip（20px 语义状态族：neutral/info/warning 三态 + 未知/读取中=neutral；与许可徽标/反作弊服务名同族）
         [W1.5 D10] 样式与 DataContext 约定：消费位 Border 须设 DataContext=FeaturesViewModel（PowerState 在其上）
         [W1.5 D11] Padding 8,3（06 C-7.3 padding 0 8px）+ 低电量/未知态 ToolTip（C-7.5 明细） -->
    <Style x:Key="RbcPowerStateChip" TargetType="Border">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="CornerRadius" Value="{StaticResource RbcRadiusPill}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource RbcNeutralBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RbcNeutralBorder}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PowerState}" Value="laptop">
                <Setter Property="Background" Value="{StaticResource RbcInfoBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RbcInfoBorder}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PowerState}" Value="low">
                <Setter Property="Background" Value="{StaticResource RbcWarningBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RbcWarningBorder}"/>
                <Setter Property="ToolTip" Value="回写确认将被禁用"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PowerState}" Value="unknown">
                <Setter Property="ToolTip" Value="无法检测电源状态，按保守策略处理"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- C-7 电源 chip 状态点（跟随 PowerState 语义色；DataContext 约定同上） -->
    <Style x:Key="RbcPowerStateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{StaticResource RbcNeutralFg}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PowerState}" Value="laptop">
                <Setter Property="Fill" Value="{StaticResource RbcInfoFg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PowerState}" Value="low">
                <Setter Property="Fill" Value="{StaticResource RbcWarningFg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- [W1.5 D11] ToolTip 隐式样式（06 C-7.3：Elevated 底 + BorderStrong + radius-sm +
         Raised 阴影 0 1px 2px + 12px secondary + padding 4 8；C-7 chip ToolTip 消费，
         全局浮层提示统一受益） -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource RbcBgElevated}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RbcBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource RbcTextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalOffset" Value="0"/>
        <Setter Property="VerticalOffset" Value="4"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RbcRadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.45"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- C-6 许可徽标（20px 语义状态族：五态）
         [W1.5 D10] 样式与 DataContext 约定：消费位 Border 须设 DataContext=FeaturesViewModel（LicenseState 在其上）
         [W1.5 审查 P2#4] Padding 10,3→8,3（与 C-7 电源 chip 同 20px 语义族规格对齐，06 C-6.3） -->
    <Style x:Key="RbcLicenseBadge" TargetType="Border">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="CornerRadius" Value="{StaticResource RbcRadiusPill}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource RbcNeutralBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RbcNeutralBorder}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding LicenseState}" Value="expiring">
                <Setter Property="Background" Value="{StaticResource RbcWarningBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RbcWarningBorder}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding LicenseState}" Value="active">
                <Setter Property="Background" Value="{StaticResource RbcSuccessBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RbcSuccessBorder}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding LicenseState}" Value="expired">
                <Setter Property="Background" Value="{StaticResource RbcWarningBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RbcWarningBorder}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- C-4/C-5 对话框内容通用：三段式小节（段间距 16 + 1px 分隔，06 C-4.3） -->
    <Style x:Key="RbcDialogSection" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- C-4 场景适配双列块（推荐=info 底 / 劝阻=warning 底） -->
    <Style x:Key="RbcAdviceInfo" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RbcInfoBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RbcInfoBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RbcRadiusSm}"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style x:Key="RbcAdviceWarn" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RbcWarningBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RbcWarningBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RbcRadiusSm}"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- C-3 冷热对比卡（收益页 span2 黄金位） -->
    <Style x:Key="RbcBenchmarkCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RbcBgSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RbcBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RbcRadiusMd}"/>
        <Setter Property="Padding" Value="{StaticResource RbcPadCard}"/>
    </Style>

    <!-- C-3 降级横幅（warning 底小条：能力不可用 + 原因从句） -->
    <Style x:Key="RbcDegradeBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RbcWarningBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RbcWarningBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RbcRadiusSm}"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
</ResourceDictionary>
