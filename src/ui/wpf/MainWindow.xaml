<Window x:Class="RamBoostFS.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RamBoostFS.Wpf.Views"
        xmlns:controls="clr-namespace:RamBoostFS.Wpf.Controls"
        Title="RAMBoostFS 控制台" Height="820" Width="1500" MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        Background="Transparent"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 侧边导航 ===== -->
        <Border Grid.Column="0" Background="#14000000" BorderBrush="{StaticResource LayerStrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,20,0,0">
                <!-- 品牌 -->
                <StackPanel DockPanel.Dock="Top" Margin="22,0,0,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="RAMBoostFS" Style="{StaticResource TitleText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="backendLabel" Text="连接中…" Style="{StaticResource CaptionText}" Margin="46,6,0,0"/>
                </StackPanel>

                <!-- 导航项 -->
                <StackPanel x:Name="navPanel" DockPanel.Dock="Top" Margin="12,0,12,0">
                    <Button x:Name="navDashboard" Click="Nav_Click" Tag="dashboard" Style="{StaticResource NavItemStyle}" Margin="0,2,0,2" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◧" FontSize="16" Width="26"/>
                            <TextBlock Text="总览仪表盘" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="navMemory" Click="Nav_Click" Tag="memory" Style="{StaticResource NavItemStyle}" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◫" FontSize="16" Width="26"/>
                            <TextBlock Text="内存设置" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="navVolumes" Click="Nav_Click" Tag="volumes" Style="{StaticResource NavItemStyle}" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" FontSize="16" Width="26"/>
                            <TextBlock Text="卷管理" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="navSecurity" Click="Nav_Click" Tag="security" Style="{StaticResource NavItemStyle}" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡" FontSize="15" Width="26"/>
                            <TextBlock Text="安全与设置" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="navLogs" Click="Nav_Click" Tag="logs" Style="{StaticResource NavItemStyle}" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☰" FontSize="15" Width="26"/>
                            <TextBlock Text="内核日志" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 底部版本 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="22,0,0,18">
                    <TextBlock Text="V8 · 卷块过滤驱动" Style="{StaticResource CaptionText}"/>
                    <TextBlock Text="\\.\RAMBlockCache · IOCTL 0x222000" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 内容区 ===== -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock x:Name="pageTitle" Text="总览仪表盘" Style="{StaticResource DisplayText}"/>
                    <TextBlock x:Name="pageSubtitle" Text="实时缓存命中、吞吐与内存压力" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                </StackPanel>
                <!-- 总开关放在内容右上角 -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Card}" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="缓存总开关" Style="{StaticResource CaptionText}"/>
                            <TextBlock x:Name="masterStateText" Text="已启用" Style="{StaticResource SubtitleText}"/>
                        </StackPanel>
                        <controls:RbToggleSwitch x:Name="masterToggle" VerticalAlignment="Center" Toggled="MasterToggle_Toggled"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ContentControl x:Name="pageContent" Grid.Row="1" HorizontalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
